diff --git a/inference/engine/kernels/tests/iq_import.rs b/inference/engine/kernels/tests/iq_import.rs
new file mode 100644
--- /dev/null
+++ b/inference/engine/kernels/tests/iq_import.rs
@@ -0,0 +1,41 @@
+//! Native GSQ source imports against independent GGML C fixtures.
+//! Selecting CUDA is strict; missing hardware must fail, never skip.
+use magnitude_kernels::repack_weight;
+use seismic::{BackendName, DeviceCatalog, Element, Layout, NativeSpecialization, Tensor};
+
+#[test]
+#[ignore = "requires IQ_IMPORT_DIR generated from the unchanged GGUF artifact and GGML C library"]
+fn original_iq_tensors_import_exactly_on_cuda() {
+    assert_eq!(std::env::var("SEISMIC_TEST_BACKEND").unwrap(), "cuda");
+    let device = DeviceCatalog::discover().unwrap().open_backend(BackendName::Cuda).unwrap();
+    let dir = std::path::PathBuf::from(std::env::var("IQ_IMPORT_DIR").unwrap());
+    let index = std::fs::read_to_string(dir.join("index.tsv")).unwrap();
+    let mut count = 0;
+    for line in index.lines() {
+        let fields: Vec<_> = line.split('\t').collect();
+        let [source_name, resident_name, rows, k, stem] = fields.as_slice() else { panic!("invalid fixture index") };
+        let shape = [1, rows.parse::<u64>().unwrap(), k.parse::<u64>().unwrap()];
+        let bytes = std::fs::read(dir.join(format!("{stem}.blocks"))).unwrap();
+        let oracle = std::fs::read(dir.join(format!("{stem}.values"))).unwrap();
+        assert_eq!(oracle.len() as u64, shape.iter().product::<u64>()*4);
+        let source_element = Element::named(source_name).unwrap();
+        let source = Tensor::from_host(&device, source_element, &shape, &bytes).unwrap();
+        for layout in [Layout::Packet, Layout::Rows16, Layout::Mma16] {
+            let resident = Element::stored(resident_name, layout).unwrap();
+            let value = repack_weight::native_for_device_with(
+                &device, repack_weight::Elements { E: source_element, U: resident },
+                &NativeSpecialization::new(),
+            ).unwrap().call(repack_weight::Args { source: &source }).unwrap().value;
+            let actual = value.read_to_host().unwrap();
+            // Observe physical padding too, including the unoccupied mma16 rows.
+            assert_eq!(actual, resident.repack_host(source_element, &shape, &bytes).unwrap(), "{stem} {} payload",resident.name());
+            let decoded = resident.decode_host(&shape, &actual).unwrap();
+            for (i, (v, bytes)) in decoded.iter().zip(oracle.chunks_exact(4)).enumerate() {
+                assert_eq!((*v as f32).to_bits(), u32::from_le_bytes(bytes.try_into().unwrap()), "{stem} {} value {i}",resident.name());
+            }
+        }
+        count += 1;
+        println!("{stem}: {} {shape:?} exact in packet/rows16/mma16", resident_name);
+    }
+    assert!(count >= 315, "every affected tensor must be represented");
+}
