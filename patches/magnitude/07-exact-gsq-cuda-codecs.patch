--- /dev/null
+++ b/inference/seismic/lang/src/external_iq.rs
@@ -0,0 +1,97 @@
+//! Exact source-packet conversion recipes for importance-grid quantizers.
+//! Resident palettes carry every source value; they do not requantize weights.
+
+use crate::registry::{PlaneRepackRecipe as Plane, RepackExpr as E};
+#[path = "external_iq_tables.rs"]
+mod tables;
+use tables::*;
+
+fn bits(bit: u32, width: u8) -> E { E::SourceBits { bit, width } }
+fn shift(x: E, by: u8) -> E { E::ShiftLeft { value: Box::new(x), bits: by } }
+fn or(a: E, b: E) -> E { E::BitOr(Box::new(a), Box::new(b)) }
+fn add(x: E, offset: i32) -> E { E::OffsetI32 { value: Box::new(x), offset } }
+fn lookup(x: E, table: &'static [i32]) -> E { E::Lookup { index: Box::new(x), table } }
+fn half(x: E) -> E { E::F16ToF32(Box::new(x)) }
+fn float(x: E) -> E { E::I32ToF32(Box::new(x)) }
+fn mul(a: E, b: E) -> E { E::MultiplyF32(Box::new(a), Box::new(b)) }
+fn constant(x: f32) -> E { E::ConstantF32 { bits: x.to_bits() } }
+
+fn scale_bits(source: &str) -> E {
+    if source != "gguf_iq1_m" { return bits(0,16); }
+    let mut value = bits(48*8+12,4);
+    for j in 1..4 { value = or(value,shift(bits((48+2*j)*8+12,4),(4*j) as u8)); }
+    value
+}
+
+fn code(source: &str, p: u32) -> E {
+    let (b, l, j) = (p/32, p%32/8, p%8);
+    let (point, sign, point_bits, slots, table) = match source {
+        "gguf_iq1_s" => (
+            or(bits((2+4*b+l)*8,8),shift(bits((34+2*b)*8+3*l,3),8)),
+            bits((34+2*b)*8+15,1), 11, 3, &IQ1S_GRID_CODES[..],
+        ),
+        "gguf_iq1_m" => (
+            or(bits((4*b+l)*8,8),shift(bits((32+2*b+l/2)*8+4*(l%2),3),8)),
+            bits((32+2*b+l/2)*8+4*(l%2)+3,1), 11, 3, &IQ1S_GRID_CODES[..],
+        ),
+        "gguf_iq2_xxs" => (
+            bits((2+8*b+l)*8,8),
+            lookup(bits((6+8*b)*8+7*l,7),&PARITY_SIGNS[j as usize]),
+            8, 3, &IQ2XXS_GRID_CODES[..],
+        ),
+        "gguf_iq2_xs" => (
+            bits((2+2*(4*b+l))*8,9),
+            lookup(bits((2+2*(4*b+l))*8+9,7),&PARITY_SIGNS[j as usize]),
+            9, 3, &IQ2XS_GRID_CODES[..],
+        ),
+        "gguf_iq2_s" => (
+            or(bits((2+4*b+l)*8,8),shift(bits((66+b)*8+2*l,2),8)),
+            bits((34+4*b+l)*8+j,1), 10, 3, &IQ2S_GRID_CODES[..],
+        ),
+        "gguf_iq3_xxs" => (
+            bits((2+8*b+2*l+j/4)*8,8),
+            lookup(bits((66+4*b)*8+7*l,7),&PARITY_SIGNS[j as usize]),
+            8, 2, &IQ3XXS_GRID_CODES[..],
+        ),
+        "gguf_q2_k" => return bits((16+(p/128)*32+p%32)*8+2*(p%128/32),2),
+        _ => unreachable!("unknown registered IQ source"),
+    };
+    let index = add(shift(or(point,shift(sign,point_bits)),slots), (j % (1<<slots)) as i32);
+    lookup(index, table)
+}
+
+pub(crate) fn recipes(source: &str) -> Option<Vec<(&'static str, Plane)>> {
+    let group = match source {
+        "gguf_iq1_s" | "gguf_iq2_xxs" | "gguf_iq3_xxs" => 32,
+        "gguf_iq1_m" | "gguf_iq2_xs" | "gguf_iq2_s" => 16,
+        "gguf_q2_k" => {
+            return Some(vec![
+                ("words",Plane::PackedEntries((0..256).map(|p|code(source,p)).collect())),
+                ("coefficients",Plane::BitRoutes((0..128).collect())),
+                ("scale_factor",Plane::BitRoutes((80*8..82*8).collect())),
+                ("bias_factor",Plane::BitRoutes((82*8..84*8).collect())),
+            ]);
+        }
+        _ => return None,
+    };
+    let base=half(scale_bits(source));
+    let scales=(0..256/group).map(|g| {
+        let b=g*group/32;
+        let (local, factor) = match source {
+            "gguf_iq1_s" => (bits((34+2*b)*8+12,3),0.125),
+            "gguf_iq1_m" => (bits((48+2*(b/2))*8+6*(b%2)+3*(g%2),3),0.125),
+            "gguf_iq2_xxs" => (bits((6+8*b)*8+28,4),0.125),
+            "gguf_iq2_xs" => (bits((66+b)*8+4*(g%2),4),0.125),
+            "gguf_iq2_s" => (bits((74+b)*8+4*(g%2),4),0.125),
+            "gguf_iq3_xxs" => (bits((66+4*b)*8+28,4),0.25),
+            _ => unreachable!(),
+        };
+        // F16 * odd integer is exactly representable as F32. The dyadic
+        // factor is exact too, preserving the source operation's boundaries.
+        mul(mul(base.clone(),float(add(shift(local,1),1))),constant(factor))
+    }).collect();
+    Some(vec![
+        ("words",Plane::PackedEntries((0..256).map(|p|code(source,p)).collect())),
+        ("scale",Plane::DenseValues(scales)),
+    ])
+}
