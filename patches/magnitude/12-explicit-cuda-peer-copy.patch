+        /// Exact byte transfer into this canonical, fully backed destination.
+        /// Both allocations keep their physical owner and charge. Foreign tensors
+        /// are never admitted as native graph bindings on the receiving device.
+        pub fn copy_from_peer(&self, source: &Self) -> Result<(), TensorError> {
+            let invalid = |reason: &str| TensorError::DeviceTransfer(reason.into());
+            if self.slabs.is_some() || source.slabs.is_some() {
+                return Err(invalid("peer copy requires contiguous tensor views"));
+            }
+            self.backed()?; source.backed()?;
+            if self.allocation.storage().read_only() {
+                return Err(invalid("destination storage is read-only"));
+            }
+            if self.representation != source.representation || self.extents != source.extents {
+                return Err(invalid("source and destination representation and shape must match"));
+            }
+            let canonical = crate::layout::canonical(self.representation, &self.extents)?;
+            if self.strides != canonical.strides || source.strides != canonical.strides
+                || self.byte_len != canonical.byte_len || source.byte_len != canonical.byte_len {
+                return Err(invalid("peer copy requires canonical contiguous layouts"));
+            }
+            let (crate::backends::OpenedKind::Cuda(source_device), crate::backends::OpenedKind::Cuda(destination_device))
+                = (&source.device.kind, &self.device.kind) else {
+                return Err(invalid("direct peer copy requires two CUDA devices"));
+            };
+            if self.allocation.access_identity() == source.allocation.access_identity() {
+                return Err(invalid("source and destination alias the same access group"));
+            }
+            // Stable lock order prevents opposite-direction transfers from
+            // deadlocking. Host permits wait for all conflicting device fences.
+            let (_first, _second) = if source.allocation.access_identity() < self.allocation.access_identity() {
+                (source.allocation.acquire(false), self.allocation.acquire(true))
+            } else {
+                (self.allocation.acquire(true), source.allocation.acquire(false))
+            };
+            let from = crate::driver::typed_buffer::<seismic_cuda::Cuda, seismic_cuda::Executor>(&source.allocation);
+            let to = crate::driver::typed_buffer::<seismic_cuda::Cuda, seismic_cuda::Executor>(&self.allocation);
+            destination_device.service().copy_from_peer(source_device.service(), from,
+                source.byte_offset, to, self.byte_offset, self.byte_len)?;
+            Ok(())
+        }
+
         pub fn device(&self) -> &Arc<DeviceInner> {
