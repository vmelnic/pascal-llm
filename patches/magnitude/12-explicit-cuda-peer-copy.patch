+/// An explicit synchronous copy between separate physical contexts. The caller
+/// holds source-read and destination-write allocation permits through completion.
+/// The transfer stream is separate from either device's native execution queue.
+pub(crate) fn copy_peer(
+    source: &Context, destination: &Context,
+    source_pointer: u64, destination_pointer: u64, bytes: usize,
+) -> Result<(), DriverError> {
+    let driver = &destination.driver;
+    let missing = |operation| DriverError {
+        operation, code: -1, description: "driver has no peer-copy capability".into(),
+    };
+    let can_access = driver.device_can_access_peer.ok_or_else(|| missing("peer access query"))?;
+    let enable = driver.context_enable_peer_access.ok_or_else(|| missing("peer access enable"))?;
+    let copy = driver.memcpy_peer_async.ok_or_else(|| missing("peer copy"))?;
+    let _current = destination.enter()?;
+    let mut accessible = 0;
+    unsafe {
+        driver.check(can_access(&mut accessible, destination.ordinal, source.ordinal), "peer access query")?;
+        if accessible == 0 {
+            return Err(DriverError {
+                operation: "peer copy", code: -1,
+                description: "the physical devices do not support direct peer access".into(),
+            });
+        }
+        // Recheck the current contexts on every copy. A retained primary
+        // context may have been recreated since an earlier engine lifetime.
+        let result = enable(source.raw, 0);
+        if result != 704 { driver.check(result, "peer access enable")?; }
+        driver.check(copy(destination_pointer, destination.raw, source_pointer,
+                          source.raw, bytes, destination.transfer), "peer copy")?;
+        driver.check((driver.stream_synchronize)(destination.transfer), "peer copy completion")
     }
 }
 
