+    /// Copy exact bytes between physical CUDA devices. No host staging or
+    /// allocation occurs. Runtime allocation permits order all producers and
+    /// consumers before this synchronous boundary is entered.
+    pub fn copy_from_peer(
+        &self, source: &Device, source_buffer: &Buffer, source_offset: u64,
+        destination_buffer: &Buffer, destination_offset: u64, bytes: u64,
+    ) -> Result<(), ExecutionError> {
+        if self.ordinal() == source.ordinal() {
+            return Err(ExecutionError::SubmissionFailed("peer copy requires distinct physical devices".into()));
+        }
+        let in_bounds = |offset: u64, length: u64| offset.checked_add(bytes).is_some_and(|end| end <= length);
+        if !in_bounds(source_offset, source_buffer.len()) || !in_bounds(destination_offset, destination_buffer.len()) {
+            return Err(ExecutionError::SubmissionFailed("peer copy exceeds its tensor backing".into()));
+        }
+        let bytes = usize::try_from(bytes).map_err(|_| ExecutionError::SubmissionFailed("peer copy exceeds host address range".into()))?;
+        if bytes == 0 { return Ok(()); }
+        crate::driver::copy_peer(&source.context, &self.context,
+            source_buffer.pointer() + source_offset,
+            destination_buffer.pointer() + destination_offset, bytes).map_err(submission_error)
     }
 
