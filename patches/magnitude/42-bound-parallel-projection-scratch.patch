+/// One arena per source queue and peer. Graph fork/join plus source-stream
+/// order serializes frame reuse; different source queues never share a frame.
+fn scratch(source:&Arc<DeviceInner>,peer:&Arc<DeviceInner>,bytes:u64,builder:&mut DirectGraphBuilder)->Result<Arc<Allocation>,CallError> {
+    let key=source.kind.identity().0;
+    let mut arenas=peer.projection_scratch.lock().expect("projection scratch cache lock poisoned");
+    if let Some(arena)=arenas.get(&key).filter(|arena|arena.bytes()>=bytes) {
+        builder.retain(arena.clone());return Ok(arena.clone());
+    }
+    let capacity=bytes.max(16).checked_next_power_of_two().ok_or_else(||invalid("projection scratch capacity overflows"))?;
+    let arena=allocate(peer,capacity,builder)?;
+    arenas.insert(key,arena.clone());Ok(arena)
+}
+fn frame_region(cursor:&mut u64,bytes:u64)->Result<u64,CallError> {
+    let offset=*cursor;
+    let aligned=bytes.checked_add(15).ok_or_else(||invalid("projection frame alignment overflows"))? & !15;
+    *cursor=cursor.checked_add(aligned).ok_or_else(||invalid("projection frame extent overflows"))?;
+    Ok(offset)
+}
