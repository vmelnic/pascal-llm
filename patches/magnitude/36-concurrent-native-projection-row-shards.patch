+#[derive(Clone, Debug)]
+pub struct RowShardPlan {
+    pub rows: u64,
+    pub row_stride: u64,
+    pub canonical_bytes: u64,
+    pub granularity: u64,
+    pub reserved_bytes: u64,
+    pub row_ranges: Vec<(u64,u64)>,
+    pub physical_bytes: Vec<u64>,
+    page_ranges: Vec<(u64,u64)>,
+}
+impl RowShardPlan {
+    pub(crate) fn new(rows:u64,row_stride:u64,bytes:u64,owners:usize,granularity:u64) -> Result<Self,DriverError> {
+        if rows==0 || row_stride==0 || owners<2 || !granularity.is_power_of_two() {
+            return Err(invalid("invalid row-shard geometry"));
+        }
+        let covered=rows.checked_mul(row_stride).ok_or_else(||invalid("row-shard size overflows"))?;
+        if covered>bytes { return Err(invalid("canonical row range exceeds its weight storage")); }
+        let pages=bytes.checked_add(granularity-1).ok_or_else(||invalid("row-shard page count overflows"))?/granularity;
+        let reserved_bytes=pages.checked_mul(granularity).ok_or_else(||invalid("row-shard reservation overflows"))?;
+        let tiles=rows.div_ceil(128);
+        let mut cuts=Vec::with_capacity(owners+1);
+        for i in 0..=owners {
+            let groups=(u128::from(tiles)*i as u128/owners as u128) as u64;
+            cuts.push(groups.saturating_mul(128).min(rows));
+        }
+        let mut row_ranges=Vec::new();let mut page_ranges=Vec::new();let mut physical_bytes=Vec::new();
+        for i in 0..owners {
+            row_ranges.push((cuts[i],cuts[i+1]));
+            let start=cuts[i]*row_stride;
+            let end=if i+1==owners { bytes } else { cuts[i+1]*row_stride };
+            let range=if cuts[i]==cuts[i+1] { (0,0) } else { (start/granularity,end.div_ceil(granularity)) };
+            page_ranges.push(range);
+            physical_bytes.push((range.1-range.0)*granularity);
+        }
+        Ok(Self {rows,row_stride,canonical_bytes:bytes,granularity,reserved_bytes,row_ranges,physical_bytes,page_ranges})
+    }
+}
