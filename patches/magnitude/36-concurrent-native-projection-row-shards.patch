+        for output in &spec.outputs {
+            let (begin,end)=row_range(output.columns,owner,peers.len());if begin==end {continue;}
+            let offset=(output.first+begin).checked_mul(output.element_bytes).ok_or_else(||invalid("projection gather offset overflows"))?;
+            let width=(end-begin)*output.element_bytes;
+            let allocation=output_buffers.get(&output.buffer).expect("projection output was allocated");
+            let from=typed_buffer::<Cuda,Executor>(allocation).pointer()+offset;
+            let (target,target_offset)=buffers[output.buffer];let destination=typed_buffer::<Cuda,Executor>(target).pointer()+target_offset+offset;
+            let node=builder.copy_after(device,from,None,destination,width,output.rows,output.pitch,output.pitch,&[kernel]).map_err(CallError::Execution)?;
+            gathers.push(node);
+        }
+        if gathers.is_empty() {terminals.push(kernel);} else {terminals.extend(gathers);}
+        // The graph retains copied input and output allocations independently
+        // of the source session's invocation lifetime.
+        for allocation in copied {builder.retain(allocation);}
+        for allocation in output_buffers.into_values() {builder.retain(allocation);}
+    }
+    if !terminals.is_empty() {builder.join(terminals);}
+    Ok(true)
+}
