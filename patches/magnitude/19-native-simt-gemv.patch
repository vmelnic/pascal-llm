+/// The changed Pascal GEMV route: original source formats, independent F64
+/// projection bounds and exact row/batch invariance at real proposal widths.
+#[test]
+fn cuda_pascal_gemv_actual_rows_match_host_and_single_bits() {
+    let Some(device) = cuda() else { return };
+    let mut rng = Rng(20261010);
+    let (h, f) = (512, 512);
+    let formats = [Format::Iq1S, Format::Iq1M, Format::Iq2Xxs, Format::Iq2Xs,
+        Format::Iq2S, Format::Iq3Xxs, Format::Q2K, Format::Q4K,
+        Format::Q6K, Format::Iq4];
+    for format in formats {
+        let gate = weight(&device, format, f, h, &mut rng);
+        let up = weight(&device, format, f, h, &mut rng);
+        let down = weight(&device, format, h, f, &mut rng);
+        for &mapping in &[GEMV_MAPPINGS[0], GEMV_MAPPINGS[1]] {
+            for o in [1, 3, 11] {
+                let case = DenseCase::new(o, h, f, &mut rng);
+                let residual = f32_tensor(&device, &[case.m as u64, h as u64], &case.residual);
+                let norm = f32_tensor(&device, &[h as u64], &case.norm);
+                let indices = i32_tensor(&device, &[o as u64], &case.out_rows);
+                let expand = expand_kernel(&device, format, &case, mapping);
+                let empty = f32_tensor(&device, &[0], &[]);
+                let product = expand.call(dense_expand::Args {
+                    residual: &residual, norm: &norm, gate_weight: &gate.tensor,
+                    up_weight: &up.tensor, out_rows: &indices, eps: EPSILON,
+                    activation: 0, gate_scale: &empty, up_scale: &empty,
+                }).unwrap().value;
+                let actual = read_bf16(&product);
+                let (expected, tolerance) = case.expand(&gate, &up, mapping);
+                check(&format!("Pascal expand {format:?} M={o} {mapping:?}"),
+                    &actual, &expected, &tolerance);
+                let output = output_kernel(&device, format, h, f, mapping);
+                let zeros = f32_tensor(&device, &[o as u64, h as u64], &vec![0.0; o*h]);
+                let contiguous = i32_tensor(&device, &[o as u64], &(0..o as i32).collect::<Vec<_>>());
+                let result = output.call(dense_output::Args {
+                    residual: &zeros, product: &product, down_weight: &down.tensor,
+                    out_rows: &contiguous, down_scale: &empty,
+                }).unwrap().value;
+                let projected = read_f32(&result);
+                let (expected, magnitude) = project(&actual, &down.values, o, h, f);
+                let tolerance: Vec<f64> = (0..o*h).map(|i|
+                    expected[i].abs()/256.0 + magnitude[i]*2e-5 + 1e-6).collect();
+                check(&format!("Pascal output {format:?} M={o} {mapping:?}"),
+                    &projected, &expected, &tolerance);
+                for row in 0..o {
+                    let selected = i32_tensor(&device, &[1], &[case.out_rows[row]]);
+                    let single = expand.call(dense_expand::Args {
+                        residual: &residual, norm: &norm, gate_weight: &gate.tensor,
+                        up_weight: &up.tensor, out_rows: &selected, eps: EPSILON,
+                        activation: 0, gate_scale: &empty, up_scale: &empty,
+                    }).unwrap().value;
+                    let single_values = read_bf16(&single);
+                    assert_eq!(single_values.iter().map(|v| v.to_bits()).collect::<Vec<_>>(),
+                        actual[row*f..(row+1)*f].iter().map(|v| v.to_bits()).collect::<Vec<_>>(),
+                        "Pascal expand row/batch {format:?} M={o} row={row}");
+                    let zero = f32_tensor(&device, &[1, h as u64], &vec![0.0; h]);
+                    let one_index = i32_tensor(&device, &[1], &[0]);
+                    let single_output = output.call(dense_output::Args {
+                        residual: &zero, product: &single, down_weight: &down.tensor,
+                        out_rows: &one_index, down_scale: &empty,
+                    }).unwrap().value;
+                    assert_eq!(read_f32(&single_output).iter().map(|v| v.to_bits()).collect::<Vec<_>>(),
+                        projected[row*h..(row+1)*h].iter().map(|v| v.to_bits()).collect::<Vec<_>>(),
+                        "Pascal output row/batch {format:?} M={o} row={row}");
+                }
+            }
+        }
+    }
+}
