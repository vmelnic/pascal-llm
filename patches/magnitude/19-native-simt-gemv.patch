+#if __CUDA_ARCH__ < 800
+// Native SIMT GEMV: four lanes own a weight row's interleaved K values.
+// Only actual activation rows are evaluated. Every row uses the same fixed
+// group association at every M; resident decoding and F32 scale/bias folds
+// are shared with the tensor-core path.
+template <int NB, class W, class Pro>
+__device__ __forceinline__ void gemv_accumulate_simt(
+    float (&acc)[NB][4], const typename W::Raw &raw, const W &w,
+    const typename W::Block &block, int q, u32 M, u64 k0, const Pro &pro) {
+    const u32 t = threadIdx.x % 4;
+    Coefficients<W::GROUPS> coefficients;
+    w.coefficients(block, q, coefficients);
+    constexpr int STEPS = W::GROUP / 16;
+#pragma unroll
+    for (int group = 0; group < W::GROUPS; ++group) {
+        u32 a[STEPS][4];
+#pragma unroll
+        for (int j = 0; j < STEPS; ++j)
+            w.template decode<Op>(raw, group * STEPS + j, a[j]);
+#pragma unroll
+        for (int nb = 0; nb < NB; ++nb)
+        for (u32 column = 0; column < 8 && 8 * nb + column < M; ++column) {
+            const u32 m = 8 * nb + column;
+            float p[2] = {0.0f, 0.0f};
+            float sum = 0.0f;
+#pragma unroll
+            for (int j = 0; j < STEPS; ++j) {
+                const u64 k = k0 + 16 * (group * STEPS + j) + 2 * t;
+                const float2 x[2] = {Op::unpack(pro.pair(nullptr, m, k)),
+                                     Op::unpack(pro.pair(nullptr, m, k + 8))};
+#pragma unroll
+                for (int half = 0; half < 2; ++half) {
+#pragma unroll
+                    for (int row = 0; row < 2; ++row) {
+                        const float2 code = Op::unpack(a[j][2 * half + row]);
+                        p[row] = seismic_fma_rn(code.x, x[half].x, p[row]);
+                        p[row] = seismic_fma_rn(code.y, x[half].y, p[row]);
+                    }
+                    if constexpr (W::BIAS) {
+                        sum = seismic_add_rn(sum, x[half].x);
+                        sum = seismic_add_rn(sum, x[half].y);
+                    }
+                }
+            }
+#pragma unroll
+            for (u32 mask = 1; mask <= 2; mask *= 2) {
+#pragma unroll
+                for (int row = 0; row < 2; ++row)
+                    p[row] = seismic_add_rn(p[row], seismic_shfl_xor_f32(p[row], mask));
+                if constexpr (W::BIAS)
+                    sum = seismic_add_rn(sum, seismic_shfl_xor_f32(sum, mask));
+            }
+            // Keep the existing C-fragment layout and cross-part reduction.
+            if (t == column / 2) {
+#pragma unroll
+                for (int row = 0; row < 2; ++row) {
+                    // Fixed register indices: dynamic indexing would spill
+                    // the C fragment into thread-local memory.
+                    float out = column % 2 == 0 ? acc[nb][2 * row] : acc[nb][2 * row + 1];
+                    out = seismic_fma_rn(coefficients.scale[row][group], p[row], out);
+                    if constexpr (W::BIAS)
+                        out = seismic_fma_rn(-coefficients.bias[row][group], sum, out);
+                    if (column % 2 == 0) acc[nb][2 * row] = out;
+                    else acc[nb][2 * row + 1] = out;
+                }
+            }
+        }
+    }
+}
