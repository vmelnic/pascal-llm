+//! BF16 projected inputs and independently typed F16 history on real devices.
+//! The scalar F32 softmax oracle is independent of the native implementations.
+use magnitude_kernels::{attention_decode, attention_prefill};
+use seismic::{BackendName, Device, DeviceCatalog, Element, NativeSpecialization, SlabRegion, SlabTensor, Tensor};
+use seismic_lang::{reference_math::{float_literal, ReferenceScalar}, types::DType};
+
+const KV: usize = 4;
+const G: usize = 6;
+const W: usize = 256;
+const OLD: usize = 7;
+const SLAB: usize = 4;
+
+fn rounded(dtype: DType, x: f32) -> f32 {
+    float_literal(dtype, f64::from(x)).to_f64() as f32
+}
+
+fn bytes(dtype: DType, values: &[f32]) -> Vec<u8> {
+    values.iter().flat_map(|x| (float_literal(dtype, f64::from(*x)).bits() as u16).to_le_bytes()).collect()
+}
+
+fn tensor(device: &Device, element: Element, shape: &[usize], data: Vec<u8>) -> Tensor {
+    Tensor::from_host(device, element, &shape.iter().map(|x| *x as u64).collect::<Vec<_>>(), &data).unwrap()
+}
+
+fn bf16(device: &Device, shape: &[usize], values: &[f32]) -> Tensor {
+    tensor(device, Element::bf16(), shape, bytes(DType::BF16, values))
+}
+
+fn ints(device: &Device, shape: &[usize], values: &[i32]) -> Tensor {
+    tensor(device, Element::i32(), shape, values.iter().flat_map(|x| x.to_le_bytes()).collect())
+}
+
+fn history(device: &Device, values: &[f32], rows: usize) -> SlabTensor {
+    let mut result = SlabTensor::new(device, SLAB as u64, rows as u64,
+        vec![SlabRegion { element: Element::f16(), row_shape: vec![KV as u64, W as u64] }]).unwrap();
+    for first in (0..rows).step_by(SLAB) {
+        result.add_slab().unwrap();
+        let count = SLAB.min(rows - first);
+        result.region_rows(0, first as u64, count as u64).unwrap()
+            .write_from_host(&bytes(DType::F16, &values[first * KV * W..(first + count) * KV * W])).unwrap();
+    }
+    result
+}
+
+fn history_bytes(history: &SlabTensor, rows: usize) -> Vec<u8> {
+    (0..rows).step_by(SLAB).flat_map(|first| {
+        history.region_rows(0, first as u64, SLAB.min(rows - first) as u64).unwrap().read_to_host().unwrap()
+    }).collect()
+}
+
+fn noise(count: usize, seed: usize, dtype: DType) -> Vec<f32> {
+    (0..count).map(|i| rounded(dtype, ((i * 37 + seed * 19) % 509) as f32 / 257.0 - 0.99)).collect()
+}
+
+fn oracle(query: &[f32], key: &[f32], value: &[f32], rows: usize, visible: &[i32],
+          fresh_key: &[f32], fresh_value: &[f32], fresh: &[i32]) -> Vec<f32> {
+    let mut output = vec![0.0; rows * KV * G * W];
+    for row in 0..rows {
+        for head in 0..KV * G {
+            let kv = head / G;
+            let q = &query[(row * KV * G + head) * W..][..W];
+            let mut pairs = Vec::new();
+            for span in 0..3 {
+                let at = row * 6 + span * 2;
+                for token in visible[at]..visible[at + 1] {
+                    let at = (token as usize * KV + kv) * W;
+                    pairs.push((&key[at..][..W], &value[at..][..W]));
+                }
+            }
+            for token in fresh[row * 2]..fresh[row * 2 + 1] {
+                let at = (token as usize * KV + kv) * W;
+                pairs.push((&fresh_key[at..][..W], &fresh_value[at..][..W]));
+            }
+            if pairs.is_empty() { continue; }
+            let scores = pairs.iter().map(|(k, _)| q.iter().zip(*k)
+                .fold(0.0f32, |sum, (a, b)| a.mul_add(*b, sum)) / 16.0).collect::<Vec<_>>();
+            let maximum = scores.iter().copied().fold(f32::NEG_INFINITY, f32::max);
+            let probabilities = scores.iter().map(|x| (x - maximum).exp()).collect::<Vec<_>>();
+            let denominator: f32 = probabilities.iter().sum();
+            for column in 0..W {
+                let sum = pairs.iter().zip(&probabilities).fold(0.0f32,
+                    |sum, ((_, v), p)| p.mul_add(v[column], sum));
+                output[(row * KV * G + head) * W + column] = rounded(DType::BF16, sum / denominator);
+            }
+        }
+    }
+    output
+}
+
+fn run(device: &Device, rows: usize) {
+    let total = OLD + rows;
+    let query_values = noise(rows * KV * G * W, 1, DType::BF16);
+    let mut key_values = noise(rows * KV * W, 2, DType::BF16);
+    let mut value_values = noise(rows * KV * W, 3, DType::BF16);
+    // These BF16 payloads require F16 rounding, including subnormal and signed zero.
+    let edges = [0.0, -0.0, 2.0f32.powi(-25), 2.0f32.powi(-24), -2.0f32.powi(-24), 1.0625];
+    key_values[..edges.len()].copy_from_slice(&edges);
+    value_values[..edges.len()].copy_from_slice(&edges);
+    let mut old_key = noise(total * KV * W, 4, DType::F16);
+    let mut old_value = noise(total * KV * W, 5, DType::F16);
+    assert!(old_key.iter().any(|x| rounded(DType::BF16, *x) != *x));
+    let key_slabs = history(device, &old_key, total);
+    let value_slabs = history(device, &old_value, total);
+    let mut history_key = key_slabs.logical_region(0).unwrap();
+    let mut history_value = value_slabs.logical_region(0).unwrap();
+    let query = bf16(device, &[rows, KV * G, W], &query_values);
+    let gate = bf16(device, &[rows, KV * G, 0], &[]);
+    let empty_norm = tensor(device, Element::f32(), &[0, W], vec![]);
+    let components = ints(device, &[0], &[]);
+    let empty_rotary = tensor(device, Element::f32(), &[0], vec![]);
+    let coordinates = ints(device, &[rows, 4], &vec![0; rows * 4]);
+
+    for appended in [true, false] {
+        let projected_key = if appended { key_values.as_slice() } else { &[] };
+        let projected_value = if appended { value_values.as_slice() } else { &[] };
+        let key = bf16(device, &[usize::from(appended), rows, KV * W], projected_key);
+        let value = bf16(device, &[usize::from(appended), rows, KV * W], projected_value);
+        let visible_values = (0..rows).flat_map(|row| {
+            if !appended { [OLD as i32, total as i32, 0, 0, 0, 0] }
+            else if row == 0 { [0; 6] }
+            else { [0, 3, 3, 6, 0, 0] }
+        }).collect::<Vec<_>>();
+        let fresh_values = (0..rows).flat_map(|row| [0, if appended && row > 0 { (row + 1) as i32 } else { 0 }]).collect::<Vec<_>>();
+        let visible = ints(device, &[rows, 3, 2], &visible_values);
+        let fresh = ints(device, &[rows, 2], &fresh_values);
+        let destinations = ints(device, &[rows], &(0..rows).map(|row| if appended { (OLD + row) as i32 } else { -1 }).collect::<Vec<_>>());
+        let expected = oracle(&query_values, &old_key, &old_value, rows, &visible_values,
+            projected_key, projected_value, &fresh_values);
+        let statics = NativeSpecialization::new()
+            .with_static("P", 0).with_static("S", W as u64)
+            .with_static("I", 0).with_static("U", 0)
+            .with_static("F", u64::from(appended)).with_static("N", 0).with_static("NV", 0);
+        let statics = if device.backend() == BackendName::Cuda {
+            statics.with_static("KV", KV as u64).with_static("G", G as u64)
+        } else { statics };
+        let special = if device.backend() == BackendName::Cuda && rows <= 8 {
+            statics.with_param("PARTS", 12).with_param("WARPS", 4)
+                .with_param("SLICES", 1).with_param("MATRIX", 0)
+                .with_param("STAGES", 2).with_param("COLUMNS", 1)
+        } else if device.backend() == BackendName::Cuda {
+            statics.with_param("WARPS", 2).with_param("SPLIT_GROUPS", 1)
+                .with_param("STAGES", 2).with_param("COLUMNS", 1).with_param("QREG", 1).with_param("KEY_TILE", 16)
+        } else if rows <= 8 { statics.with_param("PARTS", 8) } else { statics };
+        macro_rules! call {
+            ($module:ident) => {{
+                let kernel = $module::native_for_device_with(device,
+                    $module::Elements { A: Element::bf16(), H: Element::f16() }, &special).unwrap();
+                kernel.call($module::Args {
+                    query: &query, gate: &gate, key: &key, value: &value,
+                    query_norm: &empty_norm, key_norm: &empty_norm, value_norm: &empty_norm,
+                    rotary_components: &components, rotary_frequencies: &empty_rotary,
+                    rotary_amplitudes: &empty_rotary, coordinates: &coordinates,
+                    visible: &visible, fresh: &fresh, destinations: &destinations,
+                    history_key: &mut history_key, history_value: &mut history_value,
+                    epsilon: 1e-6, scale: 1.0 / 16.0, gate_function: 0, slab_rows: SLAB as u32,
+                }).unwrap().value
+            }};
+        }
+        let output = if rows <= 8 { call!(attention_decode) } else { call!(attention_prefill) };
+        let actual = output.read_to_host().unwrap().chunks_exact(2).map(|b|
+            ReferenceScalar::BF16(u16::from_le_bytes([b[0], b[1]])).to_f64() as f32).collect::<Vec<_>>();
+        let mut worst = 0.0f32;
+        for (i, (a, e)) in actual.iter().zip(&expected).enumerate() {
+            worst = worst.max((a - e).abs());
+            assert!((a - e).abs() <= 4e-3 + 1.6e-2 * e.abs(), "row class {rows}, appended {appended}, output {i}: {a} != {e}");
+        }
+        if appended {
+            for (destination, source) in [(&mut old_key, &key_values), (&mut old_value, &value_values)] {
+                for (i, x) in source.iter().enumerate() {
+                    destination[OLD * KV * W + i] = rounded(DType::F16, *x);
+                }
+            }
+        }
+        assert_eq!(history_bytes(&key_slabs, total), bytes(DType::F16, &old_key), "key payload and untouched rows");
+        assert_eq!(history_bytes(&value_slabs, total), bytes(DType::F16, &old_value), "value payload and untouched rows");
+        eprintln!("backend {:?}, rows {rows}, appended {appended}, max_abs {worst:e}: exact F16 payload", device.backend());
+    }
+}
+
+#[test]
+fn bf16_activations_append_and_read_f16_history() {
+    let name = std::env::var("SEISMIC_TEST_BACKEND").unwrap_or_else(|_| "cpu".into());
+    let backend = match name.as_str() { "cuda" => BackendName::Cuda, "cpu" => BackendName::Cpu, _ => panic!("select cpu or cuda explicitly") };
+    let device = DeviceCatalog::discover().unwrap().open_backend(backend).unwrap();
+    for rows in [1, 8, 9, 17] { run(&device, rows); }
+}
