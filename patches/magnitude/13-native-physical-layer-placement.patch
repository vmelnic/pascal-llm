+//! Physical layer placement. Each stage has its own capacity and byte terms;
+//! this plan never turns separate allocation pools into one memory domain.
+use super::{ModelLoadPlan, PlannedMethod, WeightStorageIdentity};
+use magnitude_family_contracts::{ModelDefinition, WeightScope};
+use magnitude_state::{KvCodec, LayerRef, ModelStateLayout};
+use seismic::DeviceSelector;
+use std::collections::HashSet;
+use std::ops::Range;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PhysicalStageBudget {
+    pub device: DeviceSelector,
+    pub capacity_bytes: u64,
+    /// Independently derived bound for graph activations, intermediates,
+    /// boundary buffers and concurrently live startup storage on this device.
+    pub reserved_bytes: u64,
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct PhysicalStageCharge {
+    pub weights: u64,
+    pub history: u64,
+    pub recurrent: u64,
+}
+impl PhysicalStageCharge {
+    fn add(self, other: Self) -> Result<Self, String> {
+        let add = |a: u64, b: u64| a.checked_add(b).ok_or("physical stage byte count overflows");
+        Ok(Self { weights: add(self.weights, other.weights)?,
+                  history: add(self.history, other.history)?,
+                  recurrent: add(self.recurrent, other.recurrent)? })
+    }
+    pub fn total(self) -> Result<u64, String> {
+        self.weights.checked_add(self.history).and_then(|n| n.checked_add(self.recurrent))
+            .ok_or_else(|| "physical stage byte count overflows".into())
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PhysicalStage {
+    pub budget: PhysicalStageBudget,
+    pub blocks: Range<usize>,
+    pub charge: PhysicalStageCharge,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct LayerPlacement {
+    stages: Vec<PhysicalStage>,
+    owners: Vec<usize>,
+    recurrent_owners: Vec<usize>,
+}
+
+fn block_index(scope: WeightScope) -> Option<usize> {
+    match scope {
+        WeightScope::TargetSublayer(index) | WeightScope::TargetBranch { sublayer: index, .. } =>
+            Some(index.block as usize),
+        _ => None,
+    }
+}
+
+impl LayerPlacement {
+    /// Search nonempty contiguous stages, keeping entry/readout/drafter on
+    /// stage zero. The exact importer roles and state descriptors are the
+    /// authority; model names and GGUF filename patterns are not inspected.
+    pub fn derive(
+        definition: &ModelDefinition, load: &ModelLoadPlan, method: PlannedMethod,
+        codec: KvCodec, budgets: &[PhysicalStageBudget], banks: usize,
+    ) -> Result<Self, String> {
+        let n = definition.decoder.blocks.len();
+        if budgets.is_empty() || budgets.len() > n || banks == 0 {
+            return Err("placement needs nonempty stages and a positive physical bank bound".into());
+        }
+        let mut selectors = HashSet::new();
+        for budget in budgets {
+            if !selectors.insert(budget.device) || budget.reserved_bytes >= budget.capacity_bytes {
+                return Err("placement has a repeated device or no independently available capacity".into());
+            }
+        }
+        let mut blocks = vec![PhysicalStageCharge::default(); n];
+        let mut root = PhysicalStageCharge::default();
+        // Deduplicate identical resident storage inside a block/root. Storage
+        // tied across different owners is copied and charged on every owner.
+        let mut seen: HashSet<(Option<usize>, WeightStorageIdentity)> = HashSet::new();
+        for weight in load.weights() {
+            let owner = block_index(weight.role.scope);
+            if !seen.insert((owner, weight.storage_identity())) { continue; }
+            let bytes = weight.storage_bytes()?;
+            let charge = match owner {
+                Some(index) => blocks.get_mut(index).ok_or("weight names a missing decoder block")?,
+                None => &mut root,
+            };
+            charge.weights = charge.weights.checked_add(bytes).ok_or("resident byte count overflows")?;
+        }
+        let drafter = if load.head().is_some() { crate::operators::draft::drafter_blocks(definition) }
+                      else { Vec::new() };
+        let layout = ModelStateLayout::derive(&definition.decoder, &drafter, codec, method.draft_rows())?;
+        let context = usize::try_from(definition.decoder.context_limit).map_err(|_| "context exceeds host address range")?;
+        for domain in layout.target_history.iter().chain(&layout.head_history) {
+            let rows = domain.kind().checkpoint_rows(context).map_err(|error| error.to_string())?;
+            for component in domain.components() {
+                let bytes = (component.row_bytes().map_err(|error| error.to_string())? as u64)
+                    .checked_mul(rows as u64).ok_or("history byte count overflows")?;
+                let charge = match component.layer {
+                    LayerRef::Target(index) => &mut blocks[index as usize],
+                    LayerRef::Head(_) => &mut root,
+                };
+                charge.history = charge.history.checked_add(bytes).ok_or("history byte count overflows")?;
+            }
+        }
+        let mut allowed_cuts = vec![true; n+1];
+        for domain in &layout.target_history {
+            if let magnitude_state::HistoryDomainLayout::Shared { source: LayerRef::Target(source), layers } = domain {
+                for layer in layers {
+                    if let LayerRef::Target(reader) = *layer {
+                        let low = (*source).min(reader) as usize;
+                        let high = (*source).max(reader) as usize;
+                        for cut in low+1..=high { allowed_cuts[cut] = false; }
+                    }
+                }
+            }
+        }
+        let mut recurrent_blocks = Vec::with_capacity(layout.target_recurrent.len());
+        let mut component = 0;
+        for (index, block) in definition.decoder.blocks.iter().enumerate() {
+            let paired = crate::operators::paired_block(block).map_err(|error| error.to_string())?;
+            let count = paired.mixer.bank_components();
+            for spec in layout.target_recurrent.get(component..component+count)
+                .ok_or("recurrent component topology differs from the decoder")? {
+                let bytes = (spec.bytes()? as u64).checked_mul(banks as u64).ok_or("bank byte count overflows")?;
+                blocks[index].recurrent = blocks[index].recurrent.checked_add(bytes).ok_or("bank byte count overflows")?;
+                recurrent_blocks.push(index);
+            }
+            component += count;
+        }
+        if component != layout.target_recurrent.len() { return Err("unassigned recurrent state component".into()); }
+        // DP minimizes the greatest occupancy of any physical device. It
+        // never grants a capacity deficit on one card using another's bytes.
+        let mut costs = vec![vec![f64::INFINITY; n+1]; budgets.len()+1];
+        let mut previous = vec![vec![None; n+1]; budgets.len()+1];
+        costs[0][0] = 0.0;
+        for stage in 0..budgets.len() {
+            for start in stage..n {
+                if !costs[stage][start].is_finite() { continue; }
+                let mut charge = if stage == 0 { root } else { PhysicalStageCharge::default() };
+                for end in start+1..=n {
+                    charge = charge.add(blocks[end-1])?;
+                    let total = charge.total()?.checked_add(budgets[stage].reserved_bytes)
+                        .ok_or("physical peak byte count overflows")?;
+                    if total > budgets[stage].capacity_bytes { break; }
+                    if !allowed_cuts[end] { continue; }
+                    let cost = costs[stage][start].max(total as f64 / budgets[stage].capacity_bytes as f64);
+                    if cost < costs[stage+1][end] {
+                        costs[stage+1][end] = cost;
+                        previous[stage+1][end] = Some(start);
+                    }
+                }
+            }
+        }
+        if !costs[budgets.len()][n].is_finite() { return Err("no contiguous placement fits every selected physical device".into()); }
+        let mut ranges = vec![0..0; budgets.len()];
+        let mut end = n;
+        for stage in (0..budgets.len()).rev() {
+            let start = previous[stage+1][end].ok_or("placement reconstruction has no predecessor")?;
+            ranges[stage] = start..end;
+            end = start;
+        }
+        let mut owners = vec![0; n];
+        let mut stages = Vec::with_capacity(budgets.len());
+        for (stage, range) in ranges.into_iter().enumerate() {
+            let mut charge = if stage == 0 { root } else { PhysicalStageCharge::default() };
+            for index in range.clone() { charge = charge.add(blocks[index])?; owners[index] = stage; }
+            stages.push(PhysicalStage { budget: budgets[stage].clone(), blocks: range, charge });
+        }
+        let recurrent_owners = recurrent_blocks.into_iter().map(|index| owners[index]).collect();
+        Ok(Self { stages, owners, recurrent_owners })
+    }
+    pub fn stages(&self) -> &[PhysicalStage] { &self.stages }
+    pub fn block_owner(&self, block: usize) -> Option<usize> { self.owners.get(block).copied() }
+    pub fn layer_owner(&self, layer: LayerRef) -> Option<usize> {
+        match layer { LayerRef::Target(index) => self.block_owner(index as usize), LayerRef::Head(_) => Some(0) }
+    }
+    pub fn recurrent_owners(&self) -> &[usize] { &self.recurrent_owners }
+}
