+fn split_physical_history(layouts: Vec<HistoryDomainLayout>, placement: &super::LayerPlacement)
+    -> Result<Vec<HistoryDomainLayout>, String> {
+    let mut result = Vec::new();
+    for layout in layouts {
+        if matches!(layout, HistoryDomainLayout::Shared { .. }) { result.push(layout); continue; }
+        let mut components = std::collections::BTreeMap::<usize,Vec<ComponentDescriptor>>::new();
+        for component in layout.components() {
+            let owner = placement.layer_owner(component.layer).ok_or("history layer has no physical owner")?;
+            components.entry(owner).or_default().push(component.clone());
+        }
+        for (_,components) in components {
+            result.push(match layout.kind() {
+                HistoryDomainKind::Token => HistoryDomainLayout::Token { components },
+                HistoryDomainKind::Window { rows } => HistoryDomainLayout::Window { rows, components },
+                HistoryDomainKind::Block { rate } => HistoryDomainLayout::Block { rate, components },
+                HistoryDomainKind::Shared { .. } => unreachable!(),
+            });
+        }
+    }
+    Ok(result)
+}
+fn install_state_owners(state: &mut StateStorePlan, placement: &super::LayerPlacement, target: bool)
+    -> Result<(), String> {
+    state.history_owners = state.domains.iter().map(|domain| {
+        let mut owners = domain.components.iter().map(|component| placement.layer_owner(component.layer));
+        let owner = owners.next().flatten().ok_or("history domain has no physical owner")?;
+        if owners.any(|next| next != Some(owner)) { return Err("history domain crosses physical owners".into()); }
+        Ok(owner)
+    }).collect::<Result<_,String>>()?;
+    state.component_owners = if target { placement.recurrent_owners().to_vec() } else { vec![0;state.recurrent_components.len()] };
+    state.physical_devices = placement.stages().iter().map(|stage|stage.budget.device).collect();
