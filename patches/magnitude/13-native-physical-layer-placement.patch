+//! One logical bank numbering backed by independently owned physical slabs.
+use crate::{ComponentSpec, Error};
+use seismic::{Device, Slab, SlabRegion, SlabTensor, Tensor, TensorStorageObserver};
+use std::rc::Rc;
+
+pub(crate) struct RecurrentSlabs {
+    pub groups: Vec<SlabTensor>,
+    components: Vec<(usize, usize)>,
+    owners: Vec<usize>,
+}
+impl RecurrentSlabs {
+    pub fn new(devices: &[Rc<Device>], owners: &[usize], specs: &[ComponentSpec],
+               slab_banks: u64, banks: u64) -> Result<Self, Error> {
+        if owners.len() != specs.len() { return Err(Error::Request("recurrent physical owners differ from the component topology".into())); }
+        let mut regions = vec![Vec::new(); devices.len()];
+        let mut addresses = Vec::with_capacity(specs.len());
+        for (&owner, spec) in owners.iter().zip(specs) {
+            let group = regions.get_mut(owner).ok_or_else(|| Error::Request("recurrent physical owner is absent".into()))?;
+            addresses.push((owner, group.len()));
+            group.push(SlabRegion { element: super::element(spec.dtype),
+                row_shape: spec.shape.iter().map(|&size| size as u64).collect() });
+        }
+        let mut groups = Vec::new();
+        let mut physical_owners=Vec::new();
+        let mut indices = vec![None; devices.len()];
+        for (owner, regions) in regions.into_iter().enumerate() {
+            if regions.is_empty() { continue; }
+            indices[owner] = Some(groups.len());
+            physical_owners.push(owner);
+            groups.push(SlabTensor::new(&devices[owner], slab_banks, banks, regions)?);
+        }
+        let components = addresses.into_iter().map(|(owner, region)|
+            (indices[owner].expect("a component has a physical group"), region)).collect();
+        Ok(Self { groups, components,owners:physical_owners })
+    }
+    pub fn logical_region(&self, index: usize) -> Result<Tensor, seismic::TensorError> {
+        let &(group, region) = self.components.get(index).ok_or_else(||
+            seismic::TensorError::SlabLayout("recurrent component is absent".into()))?;
+        self.groups[group].logical_region(region)
+    }
+    pub fn storage_by_owner(&self) -> impl Iterator<Item=(usize,u64)> + '_ { self.groups.iter().zip(&self.owners).map(|(group,&owner)|(owner,group.storage_bytes())) }
+    pub fn storage_bytes(&self) -> u64 { self.groups.iter().map(SlabTensor::storage_bytes).sum() }
+    pub fn slab_bytes(&self) -> u64 { self.groups.iter().map(SlabTensor::slab_bytes).sum() }
+    pub fn slab_storage_observers(&self) -> impl Iterator<Item=TensorStorageObserver> + '_ {
+        self.groups.iter().flat_map(SlabTensor::slab_storage_observers)
+    }
+    /// All groups publish exactly the same logical bank slabs.
+    pub fn slabs(&self) -> impl Iterator<Item=(usize, &Slab)> {
+        self.groups.first().expect("a recurrent layout has storage").slabs()
+    }
+    pub fn add_slab(&mut self) -> Result<usize, seismic::TensorError> {
+        let mut added: Vec<(usize, usize)> = Vec::new();
+        for group in 0..self.groups.len() {
+            match self.groups[group].add_slab() {
+                Ok(index) => {
+                    if let Some(&(_, first)) = added.first() { assert_eq!(index, first, "physical bank slab numbering diverged"); }
+                    added.push((group,index));
+                }
+                Err(error) => {
+                    for (previous,index) in added.into_iter().rev() {
+                        self.groups[previous].free_slab(index).unwrap_or_else(|rollback|
+                            panic!("physical bank growth failed ({error}); rollback failed ({rollback})"));
+                    }
+                    return Err(error);
+                }
+            }
+        }
+        Ok(added.first().expect("recurrent layout has physical groups").1)
+    }
+    pub fn free_slab(&mut self, index: usize) -> Result<Vec<TensorStorageObserver>, seismic::TensorError> {
+        let mut released = Vec::new();
+        for group in &mut self.groups {
+            match group.free_slab(index) {
+                Ok(Some(observer)) => released.push(observer),
+                Ok(None) => {},
+                Err(error) if released.is_empty() => return Err(error),
+                Err(error) => panic!("physical bank release failed after another group was released: {error}"),
+            }
+        }
+        Ok(released)
+    }
+}
