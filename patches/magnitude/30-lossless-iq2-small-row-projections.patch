+#[test]
+#[ignore = "requires the exact original GSQ IQ2 fixtures and the selected P100"]
+fn original_iq2_hierarchical_tensors_import_exactly_on_cuda() {
+    assert_eq!(std::env::var("SEISMIC_TEST_BACKEND").unwrap(), "cuda");
+    let device = DeviceCatalog::discover().unwrap().open_backend(BackendName::Cuda).unwrap();
+    let dir = std::path::PathBuf::from(std::env::var("IQ_IMPORT_DIR").unwrap());
+    let index = std::fs::read_to_string(dir.join("index.tsv")).unwrap();
+    let mut count = 0;
+    let mut compared = 0usize;
+    for line in index.lines() {
+        let fields: Vec<_> = line.split('\t').collect();
+        let [source_name, _, rows, k, stem] = fields.as_slice() else { panic!("invalid fixture index") };
+        let resident_name = match *source_name {
+            "gguf_iq2_xxs" => "iq2h32",
+            "gguf_iq2_xs" | "gguf_iq2_s" => "iq2h16",
+            _ => continue,
+        };
+        let shape = [1, rows.parse::<u64>().unwrap(), k.parse::<u64>().unwrap()];
+        let bytes = std::fs::read(dir.join(format!("{stem}.blocks"))).unwrap();
+        let oracle = std::fs::read(dir.join(format!("{stem}.values"))).unwrap();
+        let source_element = Element::named(source_name).unwrap();
+        let source = Tensor::from_host(&device, source_element, &shape, &bytes).unwrap();
+        for layout in [Layout::Packet, Layout::Rows16, Layout::Mma16] {
+            let resident = Element::stored(resident_name, layout).unwrap();
+            let value = repack_weight::native_for_device_with(&device,
+                repack_weight::Elements { E: source_element, U: resident },
+                &NativeSpecialization::new()).unwrap()
+                .call(repack_weight::Args { source: &source }).unwrap().value;
+            let actual = value.read_to_host().unwrap();
+            assert_eq!(actual, resident.repack_host(source_element, &shape, &bytes).unwrap(),
+                "{stem} {} physical bytes including padding", resident.name());
+            let decoded = resident.decode_host(&shape, &actual).unwrap();
+            assert_eq!(decoded.len()*4, oracle.len());
+            for (i, (v, bytes)) in decoded.iter().zip(oracle.chunks_exact(4)).enumerate() {
+                assert_eq!((*v as f32).to_bits(), u32::from_le_bytes(bytes.try_into().unwrap()),
+                    "{stem} {} exact original value {i}", resident.name());
+            }
+            compared += decoded.len();
+        }
+        count += 1;
+    }
+    assert_eq!(count, 167, "all original GSQ IQ2 tensors must be represented");
+    println!("{count} original IQ2 tensors, {compared} exact decoded comparisons in three layouts");
+}
