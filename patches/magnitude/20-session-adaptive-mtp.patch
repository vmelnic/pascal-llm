+/// Request-local hint only; target verification and configured capacity are
+/// unchanged. Efficient windows avoid paying for padded verification rows.
+#[derive(Clone)]
+struct AdaptiveDepth {
+    depth: usize,
+    full_rounds: u8,
+}
+
+impl AdaptiveDepth {
+    fn new(maximum: usize) -> Self {
+        Self { depth: maximum.min(3), full_rounds: 0 }
+    }
+
+    fn observe(&mut self, proposed: usize, accepted_rows: usize, maximum: usize) {
+        // An output-budget tail is not evidence about this window's survival.
+        if proposed != self.depth || proposed == 0 { return; }
+        if accepted_rows == proposed + 1 {
+            self.full_rounds += 1;
+            if self.full_rounds == 3 {
+                self.depth = ((self.depth + 1) * 2 - 1).min(maximum);
+                self.full_rounds = 0;
+            }
+        } else {
+            self.depth = (accepted_rows.next_power_of_two() - 1).max(1).min(maximum);
+            self.full_rounds = 0;
+        }
+    }
+}
