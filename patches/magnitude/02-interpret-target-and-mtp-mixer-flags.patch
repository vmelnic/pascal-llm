+/// Qualification against downloaded headers, without opening tensor payloads.
+#[test]
+#[ignore = "requires locally supplied 64-target-block, one-MTP GGUF headers"]
+fn local_mtp_headers_bind_original_target_and_head_geometry() {
+    let paths = std::env::var_os("MAGNITUDE_MTP_GGUF_HEADERS")
+        .expect("set MAGNITUDE_MTP_GGUF_HEADERS to a path list of GGUF headers");
+    let mut count = 0;
+    for path in std::env::split_paths(&paths) {
+        let directory = magnitude_artifacts::gguf::inspect_header(&path).unwrap();
+        let model = inspect_components(
+            &directory,
+            None,
+            PackageIdentity {
+                target: ArtifactIdentity([0; 32]),
+                projector: None,
+            },
+        )
+        .unwrap();
+        assert_eq!(model.decoder.blocks.len(), 64, "{}", path.display());
+        assert_eq!(
+            model.head.as_ref().unwrap().depth(),
+            1,
+            "{}",
+            path.display()
+        );
+        println!(
+            "{}: 64 target blocks, one MTP block admitted",
+            path.display()
+        );
+        count += 1;
+    }
+    assert!(count > 0);
+}
