+#[test]
+fn explicit_mtp_flags_preserve_target_and_head_geometry() {
+    let identity = PackageIdentity {
+        target: ArtifactIdentity([3; 32]),
+        projector: None,
+    };
+    let expected = inspect_components(&mtp_directory(), None, identity).unwrap();
+    for flags in [
+        vec![Scalar::Bool(true), Scalar::Bool(false)],
+        vec![Scalar::Bool(true), Scalar::Bool(false), Scalar::Bool(false)],
+    ] {
+        let mut directory = mtp_directory();
+        directory.metadata.push(Metadata {
+            name: "qwen35.attention.recurrent_layers".into(),
+            value: Value::Array(flags),
+        });
+        let actual = inspect_components(&directory, None, identity).unwrap();
+        assert_eq!(actual.decoder.blocks, expected.decoder.blocks);
+        assert_eq!(actual.head, expected.head);
+    }
+}
+
+#[test]
+fn explicit_mtp_flags_reject_invalid_suffix_and_lengths() {
+    for flags in [
+        vec![Scalar::Bool(true)],
+        vec![
+            Scalar::Bool(true),
+            Scalar::Bool(false),
+            Scalar::Bool(false),
+            Scalar::Bool(false),
+        ],
+        vec![Scalar::Bool(true), Scalar::Bool(false), Scalar::Bool(true)],
+        vec![Scalar::Bool(true), Scalar::Bool(false), Scalar::Unsigned(0)],
+        vec![
+            Scalar::Unsigned(1),
+            Scalar::Bool(false),
+            Scalar::Bool(false),
+        ],
+    ] {
+        let mut directory = mtp_directory();
+        directory.metadata.push(Metadata {
+            name: "qwen35.attention.recurrent_layers".into(),
+            value: Value::Array(flags),
+        });
+        assert!(inspect_components(
+            &directory,
+            None,
+            PackageIdentity {
+                target: ArtifactIdentity([3; 32]),
+                projector: None,
+            },
+        )
+        .is_err());
+    }
+}
