+namespace strata::ink {
+
+// M=1 router for TP ranks (pascal-llm): k_ink_router_gemv_smallM<1> (128 CTAs, one per expert, same dot and
+// block_sum) + k_ink_router_select_topk8 + k_ink_moe_bin fused through a last-CTA-done counter. Selection math and
+// tie-breaking are copied unchanged; binning is specialised for 8 distinct experts of one token. The counter is
+// reset by the last CTA, so the kernel replays inside CUDA graphs.
+__global__ void __launch_bounds__(256) k_tp_router_fused_m1(
+    const float* __restrict__ x, const float* __restrict__ gate_w, const float* __restrict__ gate_b,
+    const InkExpertDev* __restrict__ ex, float* __restrict__ r_logits, int32_t* __restrict__ topk_idx,
+    float* __restrict__ topk_w, float route_scale, InkMoeTables tb, unsigned* __restrict__ counter) {
+    const int e = blockIdx.x;
+    const int tid = threadIdx.x;
+    {
+        const float4* gw = reinterpret_cast<const float4*>(gate_w + (size_t)e * kInkHidden);
+        constexpr int K4 = kInkHidden / 4;
+        float acc = 0.0f;
+        for (int i = tid; i < K4; i += 256) {
+            const float4 w = gw[i];
+            const float4 xv = reinterpret_cast<const float4*>(x)[i];
+            acc = fmaf(w.x, xv.x, acc); acc = fmaf(w.y, xv.y, acc);
+            acc = fmaf(w.z, xv.z, acc); acc = fmaf(w.w, xv.w, acc);
+        }
+        __shared__ float sh[32];
+        const float s = block_sum(acc, sh);
+        if (tid == 0) r_logits[e] = s;
+    }
+    __shared__ unsigned s_last;
+    __threadfence();
+    __syncthreads();
+    if (tid == 0) s_last = (atomicAdd(counter, 1u) == (unsigned)(kInkExperts - 1)) ? 1u : 0u;
+    __syncthreads();
+    if (!s_last) return;
+    __threadfence();
+
+    __shared__ int s_id[kInkTopK];
+    __shared__ float s_w[kInkTopK];
+    if (tid < 32) {
+        const int lane = tid;
+        const volatile float* lg = r_logits;
+        float sc[4], pr[4];
+        int id[4];
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            const int ee = lane + 32 * j;
+            const float p = 1.0f / (1.0f + expf(-lg[ee]));
+            id[j] = ee; pr[j] = p; sc[j] = p + gate_b[ee];
+        }
+        int best_id[kInkTopK];
+        float best_p[kInkTopK];
+        float psum = 0.0f;
+#pragma unroll
+        for (int k = 0; k < kInkTopK; ++k) {
+            float mv = -1e30f; int mi = 1000000; float mp = 0.0f;
+#pragma unroll
+            for (int j = 0; j < 4; ++j) {
+                if (sc[j] > mv || (sc[j] == mv && id[j] < mi)) { mv = sc[j]; mi = id[j]; mp = pr[j]; }
+            }
+#pragma unroll
+            for (int o = 16; o >= 1; o >>= 1) {
+                const float ov = __shfl_xor_sync(0xFFFFFFFFu, mv, o);
+                const int   oi = __shfl_xor_sync(0xFFFFFFFFu, mi, o);
+                const float op = __shfl_xor_sync(0xFFFFFFFFu, mp, o);
+                if (ov > mv || (ov == mv && oi < mi)) { mv = ov; mi = oi; mp = op; }
+            }
+            best_id[k] = mi; best_p[k] = mp; psum += mp;
+#pragma unroll
+            for (int j = 0; j < 4; ++j) if (id[j] == mi) sc[j] = -1e30f;
+        }
+        if (lane < kInkTopK) {
+            const float inv = route_scale / (psum + 1e-20f);
+            topk_idx[lane] = best_id[lane];
+            topk_w[lane] = best_p[lane] * inv;
+            s_id[lane] = best_id[lane];
+            s_w[lane] = best_p[lane] * inv;
+        }
+    }
+    __syncthreads();
+    // Binning for one token with 8 distinct resident experts (all shards are tier 0 on TP ranks).
+    if (tid < kInkExperts) {
+        int sel = -1, below = 0;
+        for (int k = 0; k < kInkTopK; ++k) {
+            const int id = s_id[k];
+            if (ex[id].tier > 1) continue;
+            if (id == tid) sel = k;
+            if (id < tid) ++below;
+        }
+        tb.cnt[tid] = (sel >= 0) ? 1 : 0;
+        tb.off[tid] = below;
+        if (sel >= 0) {
+            tb.active[below] = tid;
+            tb.pairs[below] = sel;
+            tb.tok_idx[below] = 0;
+            tb.tiles[below] = make_int2(tid, below);
+        }
+        if (tid == kInkExperts - 1) {
+            int n = 0;
+            for (int k = 0; k < kInkTopK; ++k) n += (ex[s_id[k]].tier <= 1) ? 1 : 0;
+            tb.off[kInkExperts] = n;
+            *tb.nact = n;
+            *tb.n_tiles = n;
+            *counter = 0u;
+        }
+    }
+}
+
+}  // namespace strata::ink
