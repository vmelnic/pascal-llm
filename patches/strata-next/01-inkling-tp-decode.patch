diff --git a/engine/src/inkling2/cuda/ink_tp.cuh b/engine/src/inkling2/cuda/ink_tp.cuh
new file mode 100644
index 00000000..5b681539
--- /dev/null
+++ b/engine/src/inkling2/cuda/ink_tp.cuh
@@ -0,0 +1,145 @@
+// ink_tp.cuh - Tensor-parallel decode exchange for strata-inkling (pascal-llm patch).
+//
+// Each rank runs the same kernel sequence on its own GPU. Exchanges use a
+// low-latency protocol: every element travels as one naturally aligned 8-byte
+// volatile store {float value, uint32 epoch} into the peer's receive arena, so
+// the receiver validates each element by its epoch. There is no memory fence,
+// no separate flag and no host round trip.
+//
+// Receive slots rotate over kTpSlots epochs. A rank cannot write epoch e+kTpSlots
+// into a peer's slot before that peer has finished exchange e: the writer must
+// first read the peer's data of e+1..e+kTpSlots-1, which the peer only writes
+// after its exchange-e kernel completed (stream order).
+//
+// All-reduce sums ranks in fixed order 0..world-1, so every rank holds
+// bit-identical results and the replicated state never diverges.
+#pragma once
+
+#include <cuda_runtime.h>
+#include <cstddef>
+#include <cstdint>
+
+namespace strata::ink {
+
+constexpr int kTpMaxWorld = 4;
+constexpr int kTpSlots = 4;
+constexpr size_t kTpSlotFloats = 131072;  // elements per (slot, source rank)
+constexpr int kTpBlocks = 8;             // exchange grid; elementwise, no cross-block dependency
+constexpr int kTpThreads = 256;
+
+struct InkTpPeers {
+    uint2* recv[kTpMaxWorld] = {};  // rank p's receive arena [kTpSlots][kTpMaxWorld][kTpSlotFloats] of {value, epoch}
+};
+
+struct InkTpSeg {
+    float* y = nullptr;          // full output [M, n] (row stride n)
+    int n = 0;                   // full row length
+    const float* loc = nullptr;  // this rank's compact block [M, r0(rank+1) - r0(rank)]
+};
+
+struct InkTpSegs {
+    InkTpSeg s[8];
+    int count = 0;
+    int M = 1;
+};
+
+__host__ __device__ inline int tp_r0(int n, int rank, int world) { return (int)(((long long)n * rank) / world); }
+
+__device__ inline uint2* tp_slot_ptr(const InkTpPeers& P, int dst, int slot, int src) {
+    return P.recv[dst] + ((size_t)slot * kTpMaxWorld + src) * kTpSlotFloats;
+}
+
+// Exchange epoch: eager steps pass it directly; CUDA-graph steps pass a device base and the op index k within the
+// step, so one captured graph replays with fresh epochs (the host writes *base before every launch).
+__device__ __forceinline__ unsigned tp_epoch_of(const unsigned* base, unsigned k_or_epoch) {
+    if (base == nullptr) return k_or_epoch;
+    return *reinterpret_cast<const volatile unsigned*>(base) + k_or_epoch + 1u;
+}
+
+__device__ __forceinline__ void tp_st(uint2* p, float v, unsigned epoch) {
+    asm volatile("st.volatile.global.v2.u32 [%0], {%1, %2};" :: "l"(p), "r"(__float_as_uint(v)), "r"(epoch) : "memory");
+}
+
+__device__ __forceinline__ float tp_ld_wait(const uint2* p, unsigned epoch) {
+    unsigned v, e;
+    do {
+        asm volatile("ld.volatile.global.v2.u32 {%0, %1}, [%2];" : "=r"(v), "=r"(e) : "l"(p) : "memory");
+    } while (e != epoch);
+    return __uint_as_float(v);
+}
+
+// All-gather of row-partitioned M=1 outputs: rank r owns [r0(r), r0(r+1)) of each segment.
+__global__ void __launch_bounds__(256) k_tp_allgather(InkTpPeers P, InkTpSegs S, int rank, int world, const unsigned* base, unsigned ke) {
+    const unsigned epoch = tp_epoch_of(base, ke);
+    const int slot = (int)(epoch % kTpSlots);
+    const int M = S.M;
+    int off = 0;
+    for (int i = 0; i < S.count; ++i) {
+        const int n = S.s[i].n;
+        const int a = tp_r0(n, rank, world), w = tp_r0(n, rank + 1, world) - a;
+        for (int t = blockIdx.x * blockDim.x + threadIdx.x; t < M * w; t += gridDim.x * blockDim.x) {
+            const float v = S.s[i].loc[t];
+            for (int p = 0; p < world; ++p) {
+                if (p != rank) tp_st(tp_slot_ptr(P, p, slot, rank) + off + t, v, epoch);
+            }
+            const int m = t / w;
+            S.s[i].y[(size_t)m * n + a + (t - m * w)] = v;   // own rows into the strided full output
+        }
+        off += M * w;
+    }
+    for (int p = 0; p < world; ++p) {
+        if (p == rank) continue;
+        const uint2* src = tp_slot_ptr(P, rank, slot, p);
+        int o = 0;
+        for (int i = 0; i < S.count; ++i) {
+            const int n = S.s[i].n;
+            const int a = tp_r0(n, p, world), w = tp_r0(n, p + 1, world) - a;
+            for (int t = blockIdx.x * blockDim.x + threadIdx.x; t < M * w; t += gridDim.x * blockDim.x) {
+                const int m = t / w;
+                S.s[i].y[(size_t)m * n + a + (t - m * w)] = tp_ld_wait(src + o + t, epoch);
+            }
+            o += M * w;
+        }
+    }
+}
+
+// All-reduce (sum) of x[0..n), n <= kTpSlotFloats, fixed rank order.
+__global__ void __launch_bounds__(256) k_tp_allreduce(InkTpPeers P, float* x, int n, int rank, int world, const unsigned* base, unsigned ke) {
+    const unsigned epoch = tp_epoch_of(base, ke);
+    const int slot = (int)(epoch % kTpSlots);
+    for (int t = blockIdx.x * blockDim.x + threadIdx.x; t < n; t += gridDim.x * blockDim.x) {
+        const float v = x[t];
+        for (int p = 0; p < world; ++p) {
+            if (p != rank) tp_st(tp_slot_ptr(P, p, slot, rank) + t, v, epoch);
+        }
+    }
+    for (int t = blockIdx.x * blockDim.x + threadIdx.x; t < n; t += gridDim.x * blockDim.x) {
+        const float own = x[t];
+        float acc = 0.0f;
+        for (int p = 0; p < world; ++p) acc += (p == rank) ? own : tp_ld_wait(tp_slot_ptr(P, rank, slot, p) + t, epoch);
+        x[t] = acc;
+    }
+}
+
+}  // namespace strata::ink
+
+namespace strata::ink {
+
+// Broadcast x[0..n) from `owner` to every other rank (attention output of an owner-only global visit).
+__global__ void __launch_bounds__(256) k_tp_bcast(InkTpPeers P, float* x, int n, int owner, int rank, int world, const unsigned* base, unsigned ke) {
+    const unsigned epoch = tp_epoch_of(base, ke);
+    const int slot = (int)(epoch % kTpSlots);
+    if (rank == owner) {
+        for (int t = blockIdx.x * blockDim.x + threadIdx.x; t < n; t += gridDim.x * blockDim.x) {
+            const float v = x[t];
+            for (int p = 0; p < world; ++p) {
+                if (p != rank) tp_st(tp_slot_ptr(P, p, slot, rank) + t, v, epoch);
+            }
+        }
+    } else {
+        const uint2* src = tp_slot_ptr(P, rank, slot, owner);
+        for (int t = blockIdx.x * blockDim.x + threadIdx.x; t < n; t += gridDim.x * blockDim.x) x[t] = tp_ld_wait(src + t, epoch);
+    }
+}
+
+}  // namespace strata::ink
diff --git a/engine/src/inkling2/cuda/ink_tp_moe.cuh b/engine/src/inkling2/cuda/ink_tp_moe.cuh
new file mode 100644
index 00000000..56a22d6e
--- /dev/null
+++ b/engine/src/inkling2/cuda/ink_tp_moe.cuh
@@ -0,0 +1,398 @@
+// ink_tp_moe.cuh - M=1 SF4 expert kernels for tensor-parallel feature shards (pascal-llm patch).
+//
+// Same shard layout, weight decode (sf4_decode16_h2), 16-weight half2 dot (dot16_h2_2acc), E4M3 block scales and
+// FP32 accumulation as k_ink_moe_gu/dn_sf4_mx8, but with enough independent warps at M=1 to keep HBM2 busy on
+// SM60: the generic kernels run 24 x 8 CTAs of 128 threads for a 384-feature shard (~3.4 CTAs per P100 SM).
+//   gate/up : one warp per feature, 8 features per CTA  -> (FS / 8) x n_active CTAs of 256 threads
+//   down    : four lanes per output row, 64 rows per CTA -> (2304 / 64) x n_active CTAs of 256 threads
+// Only the cross-lane FP32 summation order differs from the generic kernels.
+#pragma once
+
+#include "ink_kernels.cuh"
+#include "ink_moe_cuda.cuh"
+
+namespace strata::ink {
+
+template <int FS>
+__global__ void __launch_bounds__(256) k_tp_moe_gu_sf4_m1(
+    const uint8_t* __restrict__ sec4_base, const InkExpertDev* __restrict__ experts, InkMoeTables tb,
+    const float* __restrict__ x_f32, float* __restrict__ h_f32) {
+    const int ai = blockIdx.y;
+    if (ai >= *tb.nact) return;
+    const int e = tb.active[ai];
+    const int row0 = tb.off[e];
+    const InkExpertDev ed = experts[e];
+    if (ed.tier > 1 || ed.gu_code != FMT_SF4) return;
+
+    __shared__ alignas(16) __half2 s_x[kInkHidden / 2];
+    const float2* src = reinterpret_cast<const float2*>(x_f32 + (size_t)tb.tok_idx[row0] * kInkHidden);
+    for (int i = threadIdx.x; i < kInkHidden / 2; i += 256) {
+        const float2 f = src[i];
+        s_x[i] = __floats2half2_rn(fminf(fmaxf(f.x, -65504.0f), 65504.0f), fminf(fmaxf(f.y, -65504.0f), 65504.0f));
+    }
+    __syncthreads();
+
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int feat = blockIdx.x * 8 + warp;
+    if (feat >= FS) return;
+    const uint8_t* body = sec4_base + ed.body_off;
+    const float2 h01 = *reinterpret_cast<const float2*>(body);
+    const float w_outer = h01.x / h01.y;
+    constexpr size_t RP = kInkHidden / 2, RS = kInkHidden / 16;   // 1152 B packs, 144 B scales per row
+    const uint8_t* bp = body + 16;
+    const uint8_t* bs = bp + (size_t)(2 * FS) * RP;
+    const uint4* gp = reinterpret_cast<const uint4*>(bp + (size_t)(2 * feat) * RP);
+    const uint4* up = reinterpret_cast<const uint4*>(bp + (size_t)(2 * feat + 1) * RP);
+    const uint16_t* gs = reinterpret_cast<const uint16_t*>(bs + (size_t)(2 * feat) * RS);
+    const uint16_t* us = reinterpret_cast<const uint16_t*>(bs + (size_t)(2 * feat + 1) * RS);
+
+    float ag = 0.0f, au = 0.0f;
+#pragma unroll
+    for (int j = 0; j < 3; ++j) {
+        const int i = lane + 32 * j;          // 72 uint4 (32 weights each) per row
+        if (i < 72) {
+            const uint4 gv = gp[i], uv = up[i];
+            const float2 sg = e4m3x2_to_f32x2(gs[i]);
+            const float2 su = e4m3x2_to_f32x2(us[i]);
+            const __half2* xh = s_x + i * 16;
+            __half2 gw[8], uw[8];
+            sf4_decode16_h2(gv.x, gv.y, gw);
+            sf4_decode16_h2(uv.x, uv.y, uw);
+            ag = fmaf(dot16_h2_2acc(gw, xh), sg.x, ag);
+            au = fmaf(dot16_h2_2acc(uw, xh), su.x, au);
+            sf4_decode16_h2(gv.z, gv.w, gw);
+            sf4_decode16_h2(uv.z, uv.w, uw);
+            ag = fmaf(dot16_h2_2acc(gw, xh + 8), sg.y, ag);
+            au = fmaf(dot16_h2_2acc(uw, xh + 8), su.y, au);
+        }
+    }
+#pragma unroll
+    for (int o = 16; o >= 1; o >>= 1) {
+        ag += __shfl_xor_sync(0xFFFFFFFFu, ag, o);
+        au += __shfl_xor_sync(0xFFFFFFFFu, au, o);
+    }
+    if (lane == 0) h_f32[(size_t)row0 * FS + feat] = situ_f32(ag * w_outer, au * w_outer);
+}
+
+template <int FS>
+__global__ void __launch_bounds__(256) k_tp_moe_dn_sf4_m1(
+    const uint8_t* __restrict__ sec4_base, const InkExpertDev* __restrict__ experts, InkMoeTables tb,
+    const float* __restrict__ h_f32, const float* __restrict__ topk_w, float* __restrict__ y_pair) {
+    const int ai = blockIdx.y;
+    if (ai >= *tb.nact) return;
+    const int e = tb.active[ai];
+    const int row0 = tb.off[e];
+    const InkExpertDev ed = experts[e];
+    if (ed.tier > 1 || ed.dn_code != FMT_SF4) return;
+
+    __shared__ alignas(16) __half2 s_h[FS / 2];
+    const float2* src = reinterpret_cast<const float2*>(h_f32 + (size_t)row0 * FS);
+    for (int i = threadIdx.x; i < FS / 2; i += 256) {
+        const float2 f = src[i];
+        s_h[i] = __floats2half2_rn(fminf(fmaxf(f.x, -65504.0f), 65504.0f), fminf(fmaxf(f.y, -65504.0f), 65504.0f));
+    }
+    __syncthreads();
+
+    const int row = blockIdx.x * 64 + (threadIdx.x >> 2);
+    const int q = threadIdx.x & 3;
+    const uint8_t* body = sec4_base + ed.body_off;
+    const float2 h23 = *reinterpret_cast<const float2*>(body + 8);
+    const float w_outer = h23.x / h23.y;
+    constexpr size_t RP = FS / 2, RS = FS / 16;               // 192 B packs, 24 B scales per output row
+    constexpr int NV = FS / 32;                               // uint4 per row (12)
+    const uint8_t* bp = body + ed.dn_off;
+    const uint8_t* bs = bp + (size_t)kInkHidden * RP;
+    const uint4* p = reinterpret_cast<const uint4*>(bp + (size_t)row * RP);
+    const uint16_t* sc = reinterpret_cast<const uint16_t*>(bs + (size_t)row * RS);
+    float y = 0.0f;
+#pragma unroll
+    for (int j = 0; j < (NV + 3) / 4; ++j) {
+        const int i = q + 4 * j;
+        if (i < NV) {
+            const uint4 v = p[i];
+            const float2 s = e4m3x2_to_f32x2(sc[i]);
+            const __half2* hh = s_h + i * 16;
+            __half2 w[8];
+            sf4_decode16_h2(v.x, v.y, w);
+            y = fmaf(dot16_h2_2acc(w, hh), s.x, y);
+            sf4_decode16_h2(v.z, v.w, w);
+            y = fmaf(dot16_h2_2acc(w, hh + 8), s.y, y);
+        }
+    }
+    y += __shfl_xor_sync(0xFFFFFFFFu, y, 2);
+    y += __shfl_xor_sync(0xFFFFFFFFu, y, 1);
+    if (q == 0) {
+        const int pid = tb.pairs[row0];
+        y_pair[(size_t)pid * kInkHidden + row] = (y * w_outer) * topk_w[pid];
+    }
+}
+
+}  // namespace strata::ink
+
+namespace strata::ink {
+
+// M=1 attention-residual depth mix for TP ranks (pascal-llm). Same math as k_ink_attn_res_mix (per-state RMS,
+// scaled dot with each query, softmax over states, weighted sum, optional RMSNorm), but each of 576 threads owns
+// one float4 of every state so all state loads are in flight together and the mix reuses them from registers.
+// Only the FP32 summation order of the reductions differs.
+__global__ void __launch_bounds__(576) k_tp_attn_res_mix_m1(  // launch with D/4 = 576 threads
+    DepthStatePtrs states, const float* __restrict__ queries, float* __restrict__ out, int n_q, int D,
+    const float* __restrict__ nw0, const float* __restrict__ nw1, const float* __restrict__ nw2) {
+    const int tid = threadIdx.x, warp = tid >> 5, lane = tid & 31;
+    const int S = states.count;
+    const int D4 = D >> 2;
+    const bool act = tid < D4;
+    __shared__ float red[40][32];
+    __shared__ float tot[40];
+    __shared__ float s_prob[4][8];
+    __shared__ float rq[32];
+
+    float4 sv[8];
+    float val[40];
+#pragma unroll
+    for (int s = 0; s < 8; ++s) {
+        sv[s] = make_float4(0.f, 0.f, 0.f, 0.f);
+        if (s < S && act) sv[s] = reinterpret_cast<const float4*>(states.p[s])[tid];
+    }
+    float4 qv[4];
+#pragma unroll
+    for (int q = 0; q < 4; ++q) {
+        qv[q] = make_float4(0.f, 0.f, 0.f, 0.f);
+        if (q < n_q && act) qv[q] = reinterpret_cast<const float4*>(queries + (size_t)q * D)[tid];
+    }
+#pragma unroll
+    for (int s = 0; s < 8; ++s) {
+        const float4 a = sv[s];
+        val[s * 5] = a.x * a.x + a.y * a.y + a.z * a.z + a.w * a.w;
+#pragma unroll
+        for (int q = 0; q < 4; ++q) {
+            float d = 0.f;
+            d = fmaf(a.x, qv[q].x, d); d = fmaf(a.y, qv[q].y, d);
+            d = fmaf(a.z, qv[q].z, d); d = fmaf(a.w, qv[q].w, d);
+            val[s * 5 + 1 + q] = d;
+        }
+    }
+#pragma unroll
+    for (int v = 0; v < 40; ++v) {
+        float x = val[v];
+#pragma unroll
+        for (int o = 16; o >= 1; o >>= 1) x += __shfl_xor_sync(0xFFFFFFFFu, x, o);
+        if (lane == 0) red[v][warp] = x;
+    }
+    __syncthreads();
+    if (tid < 40) {
+        float a = 0.f;
+        for (int w = 0; w < (int)(blockDim.x >> 5); ++w) a += red[tid][w];
+        tot[tid] = a;
+    }
+    __syncthreads();
+    if (tid == 0) {
+        const float inv_sqrt_d = rsqrtf((float)D);
+        float inv[8], sc[4][8];
+        for (int s = 0; s < S; ++s) {
+            inv[s] = rsqrtf(tot[s * 5] / (float)D + kInkRmsEps);
+            for (int q = 0; q < n_q; ++q) sc[q][s] = tot[s * 5 + 1 + q] * inv[s] * inv_sqrt_d;
+        }
+        for (int q = 0; q < n_q; ++q) {
+            float mx = -1e30f;
+            for (int s = 0; s < S; ++s) mx = fmaxf(mx, sc[q][s]);
+            float sum = 0.f;
+            for (int s = 0; s < S; ++s) { sc[q][s] = expf(sc[q][s] - mx); sum += sc[q][s]; }
+            const float inv_s = 1.0f / sum;
+            for (int s = 0; s < S; ++s) s_prob[q][s] = sc[q][s] * inv_s * inv[s];
+        }
+    }
+    __syncthreads();
+    for (int q = 0; q < n_q; ++q) {
+        const float* nw = (q == 0) ? nw0 : (q == 1 ? nw1 : nw2);
+        float ax = 0.f, ay = 0.f, az = 0.f, aw = 0.f;
+#pragma unroll
+        for (int s = 0; s < 8; ++s) {
+            if (s < S) {
+                const float w = s_prob[q][s];
+                ax = fmaf(w, sv[s].x, ax); ay = fmaf(w, sv[s].y, ay);
+                az = fmaf(w, sv[s].z, az); aw = fmaf(w, sv[s].w, aw);
+            }
+        }
+        float4* dst4 = reinterpret_cast<float4*>(out + (size_t)q * D);
+        if (!nw) {
+            if (act) dst4[tid] = make_float4(ax, ay, az, aw);
+            continue;
+        }
+        float ss = act ? (ax * ax + ay * ay + az * az + aw * aw) : 0.f;
+#pragma unroll
+        for (int o = 16; o >= 1; o >>= 1) ss += __shfl_xor_sync(0xFFFFFFFFu, ss, o);
+        if (lane == 0) rq[warp] = ss;
+        __syncthreads();
+        if (warp == 0) {
+            float t = (lane < (int)(blockDim.x >> 5)) ? rq[lane] : 0.f;
+#pragma unroll
+            for (int o = 16; o >= 1; o >>= 1) t += __shfl_xor_sync(0xFFFFFFFFu, t, o);
+            if (lane == 0) rq[0] = t;
+        }
+        __syncthreads();
+        const float inv = rsqrtf(rq[0] / (float)D + kInkRmsEps);
+        __syncthreads();
+        if (act) {
+            const float4 wv = reinterpret_cast<const float4*>(nw)[tid];
+            dst4[tid] = make_float4(ax * inv * wv.x, ay * inv * wv.y, az * inv * wv.z, aw * inv * wv.w);
+        }
+    }
+}
+
+}  // namespace strata::ink
+
+namespace strata::ink {
+
+// Exact argmax over this rank's vocabulary slice [a, a + w) of compact logits [M, w]; ties -> smallest index,
+// as k_ink_argmax_rows. Writes {value, index as float bits} per row.
+__global__ void __launch_bounds__(1024) k_tp_argmax_local(const float* __restrict__ lg_c, int w, int a, float* __restrict__ pairs) {
+    __shared__ float sv[32];
+    __shared__ int32_t si[32];
+    const float* lg = lg_c + (size_t)blockIdx.x * w;
+    float bv = -3.0e38f;
+    int32_t bi = 0x7fffffff;
+    for (int i = threadIdx.x; i < w; i += 1024) {
+        const float v = lg[i];
+        if (v > bv) { bv = v; bi = a + i; }
+    }
+#pragma unroll
+    for (int o = 16; o >= 1; o >>= 1) {
+        const float ov = __shfl_xor_sync(0xFFFFFFFFu, bv, o);
+        const int32_t oi = __shfl_xor_sync(0xFFFFFFFFu, bi, o);
+        if (ov > bv || (ov == bv && oi < bi)) { bv = ov; bi = oi; }
+    }
+    if ((threadIdx.x & 31) == 0) { sv[threadIdx.x >> 5] = bv; si[threadIdx.x >> 5] = bi; }
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        float b2 = sv[0]; int32_t i2 = si[0];
+        for (int q = 1; q < 32; ++q)
+            if (sv[q] > b2 || (sv[q] == b2 && si[q] < i2)) { b2 = sv[q]; i2 = si[q]; }
+        pairs[2 * blockIdx.x] = b2;
+        pairs[2 * blockIdx.x + 1] = __int_as_float(i2);
+    }
+}
+
+// Merge per-rank {value, index} pairs (rank r at pairs_full[r * 2M ...]) into the global argmax per row.
+__global__ void k_tp_argmax_merge(const float* __restrict__ pairs_full, int M, int world, int32_t* __restrict__ out) {
+    const int row = blockIdx.x * blockDim.x + threadIdx.x;
+    if (row >= M) return;
+    float bv = -3.0e38f;
+    int32_t bi = 0x7fffffff;
+    for (int r = 0; r < world; ++r) {
+        const float v = pairs_full[(size_t)r * 2 * M + 2 * row];
+        const int32_t i = __float_as_int(pairs_full[(size_t)r * 2 * M + 2 * row + 1]);
+        if (v > bv || (v == bv && i < bi)) { bv = v; bi = i; }
+    }
+    out[row] = bi;
+}
+
+}  // namespace strata::ink
