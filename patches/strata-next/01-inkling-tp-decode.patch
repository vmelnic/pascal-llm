+// Fast inline __half2 weight decode (8 registers = 16 weights) + 2-accumulator LDS.128 dot across ALL n_e tokens!
+// SM < 100: E2M1 -> half via PRMT (pascal-llm). Every E2M1 magnitude {0,.5,1,1.5,2,3,4,6} is a half whose low
+// byte is 0, so its high byte comes from an 8-entry byte table selected 4-at-a-time by __byte_perm; the sign bit is
+// moved to bit 15/31. Bit-identical to __floats2half2_rn(e2m1_nibble_to_f32(.)) (checked on all 2^16 byte pairs
+// and 2.7e8 random words), at ~4 instead of ~10 integer/float operations per weight.
+__device__ __forceinline__ void sf4_decode8_h2_prmt(uint32_t w, __half2* o) {
+    const uint32_t m = w & 0x77777777u;
+    const uint32_t ev = m & 0x07070707u, od = (m >> 4) & 0x07070707u;
+    const uint32_t se = ev | (ev >> 4), so = od | (od >> 4);
+    const uint32_t E = __byte_perm(0x3E3C3800u, 0x46444240u, (se & 0xFFu) | ((se >> 8) & 0xFF00u));
+    const uint32_t O = __byte_perm(0x3E3C3800u, 0x46444240u, (so & 0xFFu) | ((so >> 8) & 0xFF00u));
+#pragma unroll
+    for (int k = 0; k < 4; ++k) {
+        const uint32_t h = __byte_perm(E, O, ((4u + k) << 12) | (k << 4)) & 0xFF00FF00u;
+        const uint32_t b = w >> (8 * k);
+        const uint32_t v = h | ((b & 0x08u) << 12) | ((b & 0x80u) << 24);
+        o[k] = *reinterpret_cast<const __half2*>(&v);
+    }
+}
