+// ---- Tensor-parallel single-stream decode backend (pascal-llm) ----
+// tp_world InkCudaBackend ranks, one per GPU, each with the whole trunk and 1/tp_world of the experts.
+// Every rank executes the identical kernel sequence; dense M=1 projections are row-split and
+// all-gathered, MoE partials all-reduced, through in-kernel P2P exchanges (cuda/ink_tp.cuh).
+class InkCudaTpBackend final : public InkBackend {
+public:
+    ~InkCudaTpBackend() override {
+        ranks_.clear();
+        for (size_t i = 0; i < arenas_.size(); ++i) {
+            cudaSetDevice(gpus_[i]);
+            if (arenas_[i]) cudaFree(arenas_[i]);
+        }
+    }
+    const char* backend_name() const noexcept override { return "cuda-tp"; }
+    std::string device_info() const override { return info_; }
+    int effective_max_ctx() const override { return ranks_.empty() ? 0 : ranks_[0]->effective_max_ctx(); }
+    BackendStats stats() const override {
+        BackendStats st{};
+        if (ranks_.empty()) return st;
+        st = ranks_[0]->stats();
+        for (size_t i = 1; i < ranks_.size(); ++i) {
+            const BackendStats o = ranks_[i]->stats();
+            st.vram_experts_loaded += o.vram_experts_loaded;
+            st.ram_experts_loaded += o.ram_experts_loaded;
+            st.total_experts += o.total_experts;
+        }
+        return st;
+    }
+
+    bool init(const InkModelFile& mf, const BackendOpts& opts, std::string& err) override {
+        int n_dev = 0;
+        if (cudaGetDeviceCount(&n_dev) != cudaSuccess || n_dev <= 0) { err = "no CUDA devices"; return false; }
+        gpus_.clear();
+        if (!opts.gpu_ids.empty()) gpus_ = opts.gpu_ids;
+        else for (int g = 0; g < n_dev && (int)gpus_.size() < opts.tp_world; ++g) gpus_.push_back(g);
+        const int W = (int)gpus_.size();
+        if (W < 2 || W > strata::ink::kTpMaxWorld || W != opts.tp_world) {
+            err = "--tp " + std::to_string(opts.tp_world) + " needs exactly that many GPUs in --gpus";
+            return false;
+        }
+        for (int a = 0; a < W; ++a) {
+            for (int b = 0; b < W; ++b) {
+                if (a == b) continue;
+                int ok = 0;
+                cudaDeviceCanAccessPeer(&ok, gpus_[a], gpus_[b]);
+                if (!ok) { err = "--tp requires CUDA P2P between all GPUs"; return false; }
+                cudaSetDevice(gpus_[a]);
+                const cudaError_t e = cudaDeviceEnablePeerAccess(gpus_[b], 0);
+                if (e != cudaSuccess && e != cudaErrorPeerAccessAlreadyEnabled) {
+                    err = std::string("cudaDeviceEnablePeerAccess: ") + cudaGetErrorString(e);
+                    return false;
+                }
+                cudaGetLastError();
+            }
+        }
+        for (int r = 0; r < W; ++r) {
+            BackendOpts o = opts;
+            o.gpu_ids = {gpus_[r]};
+            o.gpu_index = gpus_[r];
+            o.gpus = 1;
+            o.layer_split.clear();
+            o.tp_rank = r;
+            o.tp_world = W;
+            cudaSetDevice(gpus_[r]);
+            auto b = std::make_unique<InkCudaBackend>();
+            if (!b->init(mf, o, err)) { err = "TP rank " + std::to_string(r) + ": " + err; return false; }
+            ranks_.push_back(std::move(b));
+        }
+        arenas_.assign(W, nullptr);
+        const size_t arena_elems = (size_t)strata::ink::kTpSlots * strata::ink::kTpMaxWorld * strata::ink::kTpSlotFloats;
+        for (int r = 0; r < W; ++r) {
+            cudaSetDevice(gpus_[r]);
+            INK_CK(cudaMalloc(&arenas_[r], arena_elems * sizeof(uint2)));
+            INK_CK(cudaMemset(arenas_[r], 0, arena_elems * sizeof(uint2)));  // epoch 0 never matches
+            INK_CK(cudaDeviceSynchronize());
+        }
+        // No allocation or free may happen inside a step once ranks exchange: cudaFree can
+        // synchronize peer devices that spin in an exchange. Pre-size every lazy buffer now.
+        for (int r = 0; r < W; ++r) {
+            cudaSetDevice(gpus_[r]);
+            auto* rn = ranks_[r]->tp_runner();
+            if (!rn->ensure_global_kv_cap(ranks_[r]->effective_max_ctx())) {
+                err = "TP rank " + std::to_string(r) + ": cannot pre-size global KV";
+                return false;
+            }
+            rn->ensure_pf_attn(strata::ink::InkCudaRunner::kInkPfKvTile);
+            rn->ensure_logits(16);
+            rn->tp_scratch();
+            INK_CK(cudaDeviceSynchronize());
+        }
+        for (int r = 0; r < W; ++r) {
+            auto* rn = ranks_[r]->tp_runner();
+            for (int p = 0; p < W; ++p) {
+                rn->tp_peers.recv[p] = arenas_[p];
+            }
+            rn->tp_rank = r;
+            rn->tp_world = W;
+            rn->tp_epoch = 0;
+        }
+        info_ = "TP" + std::to_string(W) + "[";
+        for (int r = 0; r < W; ++r) info_ += (r ? "," : "") + std::string("GPU") + std::to_string(gpus_[r]);
+        info_ += "] " + ranks_[0]->device_info();
+        std::fprintf(stderr, "[InkCUDA] tensor-parallel decode: %s\n", info_.c_str());
+        return true;
+    }
+
+    bool alloc_slot(int slot, int max_ctx, KvDtype kvd, std::string& err) override {
+        for (int r = 0; r < (int)ranks_.size(); ++r) {
+            cudaSetDevice(gpus_[r]);
+            if (!ranks_[r]->alloc_slot(slot, max_ctx, kvd, err)) return false;
+        }
+        return true;
+    }
+    void free_slot(int slot) override { each([&](int r) { ranks_[r]->free_slot(slot); }); }
+    void reset_slot(int slot) override { each([&](int r) { ranks_[r]->reset_slot(slot); }); }
+    void snapshot_slot(int slot) override { each([&](int r) { ranks_[r]->snapshot_slot(slot); }); }
+    bool save_prompt_checkpoint(int slot, int seq_len) override {
+        bool ok = true;
+        each([&](int r) { ok = ranks_[r]->save_prompt_checkpoint(slot, seq_len) && ok; });
+        return ok;
+    }
+    bool restore_prompt_checkpoint(int slot, int seq_len) override {
+        bool ok = true;
+        each([&](int r) { ok = ranks_[r]->restore_prompt_checkpoint(slot, seq_len) && ok; });
+        return ok;
+    }
+    void rollback_slot(int slot, int keep_len) override { each([&](int r) { ranks_[r]->rollback_slot(slot, keep_len); }); }
+
+    bool forward_batch(const StepBatch& batch, float* logits_out, TapCapture* taps_out, std::string& err) override {
+        const int W = (int)ranks_.size();
+        std::vector<std::string> errs(W);
+        std::vector<char> ok(W, 0);
+        int n_want = 0;
+        for (int i = 0; i < batch.n_tokens; ++i) n_want += batch.want_logits[i] ? 1 : 0;
+        // One wanted row: every rank computes its vocab slice. Otherwise rank 0 computes the full head.
+        const bool slice = (logits_out != nullptr && n_want == 1);
+        for (int r = 0; r < W; ++r) ranks_[r]->tp_runner()->tp_head_slice = slice;
+        auto run = [&](int r) {
+            cudaSetDevice(gpus_[r]);
+            float* lo = (r == 0 || slice) ? logits_out : nullptr;
+            ok[r] = ranks_[r]->forward_batch(batch, lo, r == 0 ? taps_out : nullptr, errs[r]) ? 1 : 0;
+            if (r != 0) cudaStreamSynchronize(ranks_[r]->tp_runner()->st);
+        };
+        std::vector<std::thread> th;
+        th.reserve(W - 1);
+        for (int r = 1; r < W; ++r) th.emplace_back(run, r);
+        run(0);
+        for (auto& t : th) t.join();
+        for (int r = 0; r < W; ++r) {
+            if (!ok[r]) { err = "TP rank " + std::to_string(r) + ": " + errs[r]; return false; }
+        }
+        return true;
+    }
+
+    // Speculative steps run on every rank: replicated state is bit-identical, so each rank drafts the same tree,
+    // verifies it through the same TP exchanges and accepts the same path. Rank 0's result is returned.
+    bool dspark_ready() const override {
+        for (const auto& r : ranks_) if (!r->dspark_ready()) return false;
+        return !ranks_.empty();
+    }
+    template <class F> int all_ranks(F&& f, std::string& err) {
+        const int W = (int)ranks_.size();
+        std::vector<int> res(W, 0);
+        std::vector<std::string> errs(W);
+        for (int r = 0; r < W; ++r) ranks_[r]->tp_runner()->tp_head_slice = false;
+        auto run = [&](int r) { cudaSetDevice(gpus_[r]); res[r] = f(r, errs[r]); };
+        std::vector<std::thread> th;
+        for (int r = 1; r < W; ++r) th.emplace_back(run, r);
+        run(0);
+        for (auto& t : th) t.join();
+        for (int r = 1; r < W; ++r) {
+            if (res[r] != res[0]) { err = "TP ranks diverged in a speculative step"; return -1; }
+        }
+        if (res[0] < 0) err = errs[0];
+        return res[0];
+    }
+    int dspark_draft(int slot, int32_t anchor_tok, int anchor_pos, int max_draft, int32_t* out_draft_ids, std::string& err) override {
+        const int W = (int)ranks_.size();
+        std::vector<std::vector<int32_t>> ids(W, std::vector<int32_t>(16, 0));
+        const int n = all_ranks([&](int r, std::string& e) {
+            return ranks_[r]->dspark_draft(slot, anchor_tok, anchor_pos, max_draft, ids[r].data(), e);
+        }, err);
+        if (n > 0) for (int i = 0; i < n; ++i) out_draft_ids[i] = ids[0][i];
+        return n;
+    }
+    int dspark_spec_step_greedy(int slot, int32_t anchor_tok, int anchor_pos, int max_emit, int32_t* out_emitted,
+                                int* out_drafted, std::string& err) override {
+        const int W = (int)ranks_.size();
+        std::vector<std::vector<int32_t>> em(W, std::vector<int32_t>(16, 0));
+        std::vector<int> dr(W, 0);
+        const int n = all_ranks([&](int r, std::string& e) {
+            return ranks_[r]->dspark_spec_step_greedy(slot, anchor_tok, anchor_pos, max_emit, em[r].data(), &dr[r], e);
+        }, err);
+        if (n > 0) {
+            for (int i = 0; i < n; ++i) out_emitted[i] = em[0][i];
+            for (int r = 1; r < W; ++r) {
+                for (int i = 0; i < n; ++i) if (em[r][i] != em[0][i]) { err = "TP ranks emitted different tokens"; return -1; }
+            }
+        }
+        if (out_drafted) *out_drafted = dr[0];
+        return n;
+    }
+
+    bool selfcheck(std::string& err) override {
+        cudaSetDevice(gpus_.empty() ? 0 : gpus_[0]);
+        return ranks_.empty() ? false : ranks_[0]->selfcheck(err);
+    }
+
+private:
+    template <class F> void each(F&& f) {
+        for (int r = 0; r < (int)ranks_.size(); ++r) { cudaSetDevice(gpus_[r]); f(r); }
+    }
+    std::vector<int> gpus_;
+    std::vector<std::unique_ptr<InkCudaBackend>> ranks_;
+    std::vector<uint2*> arenas_;
+    std::string info_;
+};
+
+std::unique_ptr<InkBackend> make_cuda_tp_backend() {
+    return std::make_unique<InkCudaTpBackend>();
+}
+
 }  // namespace ink2
