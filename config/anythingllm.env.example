SERVER_PORT=3001
STORAGE_DIR=/app/server/storage
UID=1000
GID=1000
JWT_SECRET=replace-with-openssl-rand-hex-32
SIG_KEY=replace-with-openssl-rand-hex-32
SIG_SALT=replace-with-openssl-rand-hex-32
LLM_PROVIDER=generic-openai
GENERIC_OPEN_AI_BASE_PATH=http://host.docker.internal:8080/v1
GENERIC_OPEN_AI_MODEL_PREF=qwen3.8-27b-ud-q4-k-m
GENERIC_OPEN_AI_MODEL_TOKEN_LIMIT=262144
GENERIC_OPEN_AI_API_KEY=local
EMBEDDING_ENGINE=native
VECTOR_DB=lancedb
WHISPER_PROVIDER=local
TTS_PROVIDER=native
DISABLE_TELEMETRY=true
