WEBUI_SECRET_KEY=replace-with-openssl-rand-hex-32
WEBUI_AUTH=true
ENABLE_SIGNUP=true
ENABLE_OPENAI_API=true
ENABLE_OPENAI_API_PASSTHROUGH=false
ENABLE_OLLAMA_API=false
ENABLE_PERSISTENT_CONFIG=false
MODELS_CACHE_TTL=1
OPENAI_API_BASE_URLS=http://host.docker.internal:8080/v1
OPENAI_API_KEYS=local
OPENAI_API_CONFIGS={"0":{"enable":true,"model_ids":[]}}
ENABLE_IMAGE_GENERATION=true
IMAGE_GENERATION_ENGINE=comfyui
IMAGE_GENERATION_MODEL=pascal-llm/realvisxl.safetensors
IMAGE_SIZE=1216x832
IMAGE_STEPS=50
ENABLE_IMAGE_PROMPT_GENERATION=true
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_API_KEY=
