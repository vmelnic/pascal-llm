WEBUI_SECRET_KEY=replace-with-openssl-rand-hex-32
WEBUI_AUTH=true
ENABLE_SIGNUP=true
ENABLE_OPENAI_API=true
ENABLE_OPENAI_API_PASSTHROUGH=false
ENABLE_OLLAMA_API=false
ENABLE_PERSISTENT_CONFIG=false
MODELS_CACHE_TTL=1
OPENAI_API_BASE_URLS=http://host.docker.internal:8080/v1
OPENAI_API_KEYS=local
OPENAI_API_CONFIGS={"0":{"enable":true,"model_ids":[]}}
