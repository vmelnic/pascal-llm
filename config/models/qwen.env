PASCAL_MODEL_PATH=${PASCAL_MODEL_ROOT}/qwen3.8-27b-ud-q4-k-m/Qwen3.8-27B-UD-Q4_K_M.gguf
PASCAL_MODEL_ID=qwen3.8-27b-ud-q4-k-m
PASCAL_MMPROJ_PATH=

PASCAL_CUDA_DEVICES=0,1,2
PASCAL_TENSOR_SPLIT=1,1,1
PASCAL_SPLIT_MODE=tensor
PASCAL_CUDA_P2P=1

PASCAL_CONTEXT_SIZE=262144
PASCAL_PARALLEL_SLOTS=4
PASCAL_CACHE_TYPE_K=f16
PASCAL_CACHE_TYPE_V=f16
# Holds one exact maximum-context target+MTP checkpoint with bounded headroom.
# The cache is process-local RAM: it survives Pi exit/resume, not server restart.
PASCAL_PROMPT_CACHE_MIB=24576

PASCAL_SPEC_TYPE=draft-mtp
PASCAL_SPEC_DRAFT_MODEL_PATH=
PASCAL_SPEC_DRAFT_N_MAX=4
PASCAL_SPEC_DRAFT_N_GPU_LAYERS=all
PASCAL_SPEC_DRAFT_CACHE_TYPE_K=f16
PASCAL_SPEC_DRAFT_CACHE_TYPE_V=f16
PASCAL_MTP_DRAFT_VOCAB_PATH=${PASCAL_MODEL_ROOT}/qwen3.8-27b-ud-q4-k-m/mtp-draft-vocab-code-ro-v1.txt
