# Common runtime configuration. Model and llama.cpp roots default to work/
# inside the deployed repository. Model-specific capabilities live in
# config/models/<profile>.env.

PASCAL_HOST=0.0.0.0
PASCAL_PORT=8080
PASCAL_API_KEY=local
PASCAL_THREADS=22
PASCAL_BATCH_THREADS=44

# The pinned SM60 patchset's decode graph slots are unsafe with tensor-split
# embedded MTP. Keep the optimization disabled until that combination is fixed
# and passes a real Pi gate.
PASCAL_DECODE_GRAPH_SLOTS=0
