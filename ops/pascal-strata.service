[Unit]
Description=Pascal Strata multi-user inference service
After=network-online.target
Wants=network-online.target
Conflicts=pascal-llm.service

[Service]
Type=simple
ExecStart=@PASCAL_REMOTE_ROOT@/ops/run-strata-server.sh
Restart=on-failure
RestartSec=5
TimeoutStartSec=900
TimeoutStopSec=60
KillSignal=SIGINT
LimitNOFILE=1048576

[Install]
WantedBy=default.target
