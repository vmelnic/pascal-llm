[Unit]
Description=Pascal native ComfyUI service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=2

[Service]
Type=simple
ExecStart=@PASCAL_REMOTE_ROOT@/ops/run-comfyui.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
LimitNOFILE=1048576

[Install]
WantedBy=default.target
